{
  "version": "2026-10-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "nodes": [
    {
      "id": "factor",
      "kind": "builtin.constant",
      "config": {
        "value": 2
      }
    },
    {
      "id": "chat",
      "kind": "builtin.llm",
      "config": {
        "model": "your-model",
        "api_key_env": "MODEL_API_KEY",
        "call_outputs": {
          "amount": "int"
        },
        "max_tool_rounds": 4,
        "max_tool_calls": 8
      }
    },
    {
      "id": "multiply",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "amount": "int",
          "factor": "int"
        },
        "code": {
          "result": "amount * factor"
        }
      },
      "inputs": {
        "factor": {
          "from": {
            "node": "factor",
            "port": "value"
          }
        }
      }
    }
  ],
  "calls": {
    "chat": {
      "multiply": {
        "target": "multiply",
        "description": "Multiply an integer by the configured factor.",
        "ports": [
          {
            "output": "amount",
            "input": "amount"
          }
        ]
      }
    }
  },
  "outputs": [
    {
      "name": "text",
      "node": "chat",
      "port": "text"
    },
    {
      "name": "history",
      "node": "chat",
      "port": "history"
    }
  ]
}
