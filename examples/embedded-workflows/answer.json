{
  "version": "2026-10-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../../crates/builtin-nodes/core"
    },
    "host": {
      "package": "embedded-flow-provider",
      "path": "./provider"
    }
  },
  "flows": {
    "flowA": {
      "path": "./answer-apply.json"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "value": {
            "type": "int",
            "default": 42,
            "secret": false
          }
        }
      }
    },
    {
      "id": "callA",
      "kind": "workflow.call",
      "config": {
        "flow": "flowA",
        "arguments": {
          "apply": {
            "/policy/body": {
              "path": "./answer-body.json"
            }
          }
        }
      },
      "inputs": {
        "apply.value": {
          "from": {
            "node": "params",
            "port": "value"
          }
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "answer",
      "node": "callA",
      "port": "answer"
    }
  ],
  "clusters": [
    {
      "label": "Call A with Flow B",
      "annotation": "Bind B to the typed policy.body leaf and forward the host value through both scopes.",
      "nodes": [
        "params",
        "callA"
      ]
    }
  ]
}
