{
  "version": "2026-10-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../../crates/builtin-nodes/core"
    }
  },
  "flows": {
    "flowA": {
      "path": "./answer-apply.json"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "value": {
            "type": "int",
            "default": 42,
            "secret": false
          }
        }
      }
    },
    {
      "id": "policy",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "./answer-body.json"
        }
      }
    },
    {
      "id": "callA",
      "kind": "workflow.call",
      "config": {
        "flow": "flowA"
      },
      "inputs": {
        "params.policy": {
          "from": {
            "node": "policy",
            "port": "value"
          }
        },
        "params.value": {
          "from": {
            "node": "params",
            "port": "value"
          }
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "answer",
      "node": "callA",
      "port": "answer"
    }
  ],
  "clusters": [
    {
      "label": "Pass a Flow to A",
      "annotation": "Pass the prepared policy Flow and the value through ordinary input edges; A invokes the received Flow.",
      "nodes": [
        "params",
        "policy",
        "callA"
      ]
    }
  ]
}
