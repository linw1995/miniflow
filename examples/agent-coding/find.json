{
  "version": "2026-11-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../../crates/builtin-nodes/core"
    },
    "coding": {
      "package": "mfn-coding",
      "path": "../../crates/builtin-nodes/coding"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "workspace_root": {
            "type": "string"
          },
          "pattern": {
            "type": "string",
            "secret": false
          },
          "path": {
            "type": "string",
            "secret": false,
            "default": "."
          },
          "kind": {
            "type": "string",
            "secret": false,
            "default": "any"
          },
          "max_depth": {
            "type": "uint",
            "secret": false,
            "default": 64
          },
          "limit": {
            "type": "uint",
            "secret": false,
            "default": 1000
          }
        }
      }
    },
    {
      "id": "find",
      "kind": "builtin.coding.find",
      "config": {
        "workspace_root": {
          "$ref": "params.workspace_root"
        }
      },
      "inputs": {
        "pattern": {
          "$ref": "params.pattern"
        },
        "path": {
          "$ref": "params.path"
        },
        "kind": {
          "$ref": "params.kind"
        },
        "max_depth": {
          "$ref": "params.max_depth"
        },
        "limit": {
          "$ref": "params.limit"
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "entries",
      "node": "find",
      "port": "entries"
    },
    {
      "name": "truncated",
      "node": "find",
      "port": "truncated"
    }
  ]
}
