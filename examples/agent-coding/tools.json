    {
      "id": "descriptions",
      "kind": "builtin.constant",
      "config": {
        "value": {
          "bash": "Run shell commands from the workspace to list or search files, create directories, or run project checks. Each call starts a new non-interactive shell. Pipes, redirections, and multiple commands are supported. Optional timeout is in seconds. stdout and stderr contain diagnostic tails (up to 50 KiB or 2000 lines each). When truncated, stdout_path or stderr_path names the complete private log; inspect selected ranges with another shell command without rerunning the original.",
          "edit": "Edit an existing file by relative path. Supply edits as a list of objects with string fields old_text and new_text. Each old_text must match exactly once in the original file; matches may not overlap. All replacements apply together.",
          "read": "Read a UTF-8 file by relative path. start_line is one-based; limit is at most 2000 lines. Continue at next_line if present.",
          "write": "Create a new UTF-8 file at a relative path with the supplied content. The parent directory must exist. Does not overwrite; use edit for existing files."
        }
      }
    },
    {
      "id": "tool_properties",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "interfaces": {
            "map": "object"
          },
          "descriptions": {
            "map": "string"
          }
        },
        "code": {
          "value": "interfaces.transformMap(name, iface, {'interface': iface, 'description': descriptions[name]})"
