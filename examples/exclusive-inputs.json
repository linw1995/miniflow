{
  "version": "2026-10-19",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "ci": {
            "type": "bool",
            "default": false,
            "secret": false
          }
        }
      }
    },
    {
      "id": "route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "ci",
            "condition": {
              "source": {
                "output": "params.ci",
                "path": ""
              },
              "operator": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "local",
      "kind": "builtin.constant",
      "config": {
        "value": {
          "mode": "local"
        }
      }
    },
    {
      "id": "ci",
      "kind": "builtin.constant",
      "config": {
        "value": {
          "mode": "ci"
        }
      }
    },
    {
      "id": "consume",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "node": "local",
              "port": "value"
            },
            {
              "node": "ci",
              "port": "value"
            }
          ]
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "result",
      "node": "consume",
      "port": "value"
    }
  ],
  "edges": [
    {
      "from_node": "params",
      "from_output": "ci",
      "to_node": "route"
    },
    {
      "from_node": "route",
      "from_output": "ci",
      "to_node": "ci"
    },
    {
      "from_node": "route",
      "from_output": "else",
      "to_node": "local"
    }
  ]
}
