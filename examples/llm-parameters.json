{
  "version": "2026-10-23",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY",
            "default": ""
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "temperature": {
            "type": "double",
            "default": 0.2,
            "secret": false
          },
          "max_tokens": {
            "type": "uint",
            "default": 256,
            "secret": false
          },
          "messages": {
            "type": {
              "list": "object"
            },
            "secret": false
          }
        }
      }
    },
    {
      "id": "chat",
      "kind": "builtin.llm",
      "config": {
        "api_key": {
          "$ref": "params.api_key"
        },
        "model": {
          "$ref": "params.model"
        },
        "base_url": {
          "$ref": "params.base_url"
        },
        "temperature": {
          "$ref": "params.temperature"
        },
        "max_tokens": {
          "$ref": "params.max_tokens"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "text",
      "node": "chat",
      "port": "text"
    },
    {
      "name": "message",
      "node": "chat",
      "port": "message",
      "optional": true
    }
  ],
  "clusters": [
    {
      "label": "Configured conversation",
      "annotation": "Resolve startup parameters and model settings before generating a response.",
      "nodes": [
        "params",
        "chat"
      ]
    }
  ]
}
