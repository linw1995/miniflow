{
  "version": "2026-11-13",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "flows": {
    "title": {
      "builtin": "mf-chat.chat-title"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "context": {
            "type": "object",
            "default": {
              "title": {
                "source": "provisional",
                "revision": 0,
                "attempted": false,
                "enabled": true
              }
            }
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY",
            "default": ""
          }
        }
      }
    },
    {
      "id": "model",
      "kind": "builtin.llm",
      "config": {
        "model": {
          "$ref": "params.model"
        },
        "base_url": {
          "$ref": "params.base_url"
        },
        "api_key": {
          "$ref": "params.api_key"
        },
        "capture_errors": true,
        "attribution": {
          "purpose": "conversation"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "conversation_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "succeeded",
            "condition": {
              "source": {
                "output": "model.status",
                "path": ""
              },
              "operator": "eq",
              "value": "succeeded"
            }
          }
        ]
      }
    },
    {
      "id": "append",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "messages": {
            "list": "object"
          },
          "message": "object"
        },
        "code": {
          "value": "messages + [dyn(message)]"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        },
        "message": {
          "from": {
            "node": "model",
            "port": "message"
          }
        }
      }
    },
    {
      "id": "unchanged",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "messages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "node": "append",
              "port": "value"
            },
            {
              "node": "unchanged",
              "port": "value"
            }
          ]
        }
      }
    },
    {
      "id": "title_prompt",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "messages": {
            "list": "object"
          }
        },
        "code": {
          "value": "string(messages[size(messages) - 1].content)"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "title",
      "kind": "workflow.call",
      "config": {
        "flow": "title"
      },
      "inputs": {
        "params.prompt": {
          "from": {
            "node": "title_prompt",
            "port": "value"
          }
        },
        "params.text": {
          "from": {
            "node": "model",
            "port": "text"
          }
        },
        "params.status": {
          "from": {
            "node": "model",
            "port": "status"
          }
        },
        "params.context": {
          "from": {
            "node": "params",
            "port": "context"
          }
        },
        "params.model": {
          "from": {
            "node": "params",
            "port": "model"
          }
        },
        "params.base_url": {
          "from": {
            "node": "params",
            "port": "base_url"
          }
        },
        "params.api_key": {
          "from": {
            "node": "params",
            "port": "api_key"
          }
        }
      }
    },
    {
      "id": "usages",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "left": {
            "list": "object"
          },
          "right": {
            "list": "object"
          }
        },
        "code": {
          "value": "left + right"
        }
      },
      "inputs": {
        "left": {
          "from": {
            "node": "model",
            "port": "usages"
          }
        },
        "right": {
          "from": {
            "node": "title",
            "port": "usages"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "model",
      "to_node": "conversation_route"
    },
    {
      "from_node": "conversation_route",
      "from_output": "succeeded",
      "to_node": "append"
    },
    {
      "from_node": "conversation_route",
      "from_output": "else",
      "to_node": "unchanged"
    }
  ],
  "outputs": [
    {
      "name": "status",
      "node": "model",
      "port": "status"
    },
    {
      "name": "text",
      "node": "model",
      "port": "text"
    },
    {
      "name": "messages",
      "node": "messages",
      "port": "value"
    },
    {
      "name": "metadata",
      "node": "model",
      "port": "metadata",
      "optional": true
    },
    {
      "name": "finish_reason",
      "node": "model",
      "port": "finish_reason",
      "optional": true
    },
    {
      "name": "usages",
      "node": "usages",
      "port": "value"
    },
    {
      "name": "error",
      "node": "model",
      "port": "error",
      "optional": true
    },
    {
      "name": "title",
      "node": "title",
      "port": "title",
      "optional": true
    },
    {
      "name": "answer",
      "node": "model",
      "port": "delta",
      "optional": true
    }
  ]
}
