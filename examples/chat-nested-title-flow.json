{
  "version": "2026-11-13",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "flows": {
    "title": {
      "builtin": "mf-chat.chat-title"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "context": {
            "type": "object",
            "default": {
              "title": {
                "source": "provisional",
                "revision": 0,
                "attempted": false,
                "enabled": true
              },
              "model_context": {
                "revision": 0
              }
            }
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY",
            "default": ""
          }
        }
      }
    },
    {
      "id": "model",
      "kind": "builtin.llm",
      "config": {
        "model": {
          "$ref": "params.model"
        },
        "capture_errors": true,
        "attribution": {
          "purpose": "conversation"
        },
        "base_url": {
          "$ref": "params.base_url"
        },
        "api_key": {
          "$ref": "params.api_key"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "title_source",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "messages": {
            "list": "object"
          }
        },
        "code": {
          "prompt": "messages[messages.size() - 1].content"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "title",
      "kind": "workflow.call",
      "config": {
        "flow": "title"
      },
      "inputs": {
        "params.prompt": {
          "from": {
            "node": "title_source",
            "port": "prompt"
          }
        },
        "params.text": {
          "from": {
            "node": "model",
            "port": "text"
          }
        },
        "params.status": {
          "from": {
            "node": "model",
            "port": "status"
          }
        },
        "params.context": {
          "from": {
            "node": "params",
            "port": "context"
          }
        },
        "params.model": {
          "from": {
            "node": "params",
            "port": "model"
          }
        },
        "params.base_url": {
          "from": {
            "node": "params",
            "port": "base_url"
          }
        },
        "params.api_key": {
          "from": {
            "node": "params",
            "port": "api_key"
          }
        }
      }
    },
    {
      "id": "usages",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "left": {
            "list": "object"
          },
          "right": {
            "list": "object"
          }
        },
        "code": {
          "value": "left + right"
        }
      },
      "inputs": {
        "left": {
          "from": {
            "node": "model",
            "port": "usages"
          }
        },
        "right": {
          "from": {
            "node": "title",
            "port": "usages"
          }
        }
      }
    },
    {
      "id": "title_available",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "title.title",
                "path": ""
              },
              "operator": "exists"
            }
          }
        ]
      }
    },
    {
      "id": "selected_title",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "title",
            "port": "title"
          }
        }
      }
    },
    {
      "id": "missing_title",
      "kind": "builtin.constant",
      "config": {
        "value": ""
      }
    },
    {
      "id": "title_value",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "node": "selected_title",
              "port": "value"
            },
            {
              "node": "missing_title",
              "port": "value"
            }
          ]
        }
      }
    },
    {
      "id": "result",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "status": "string",
          "messages": {
            "list": "object"
          },
          "primary_usages": {
            "list": "object"
          },
          "usages": {
            "list": "object"
          },
          "title": "string"
        },
        "code": {
          "value": "title == '' ? {'status':dyn(status),'messages':dyn(messages),'usages':dyn(usages),'error':dyn(status == 'failed' ? primary_usages[0].error : '')} : {'status':dyn(status),'messages':dyn(messages),'usages':dyn(usages),'error':dyn(''),'title':dyn(title)}"
        }
      },
      "inputs": {
        "status": {
          "from": {
            "node": "model",
            "port": "status"
          }
        },
        "messages": {
          "from": {
            "node": "model",
            "port": "messages"
          }
        },
        "primary_usages": {
          "from": {
            "node": "model",
            "port": "usages"
          }
        },
        "usages": {
          "from": {
            "node": "usages",
            "port": "value"
          }
        },
        "title": {
          "from": {
            "node": "title_value",
            "port": "value"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "title",
      "to_node": "title_available"
    },
    {
      "from_node": "title_available",
      "from_output": "yes",
      "to_node": "selected_title"
    },
    {
      "from_node": "title_available",
      "from_output": "else",
      "to_node": "missing_title"
    }
  ],
  "outputs": [
    {
      "name": "append",
      "node": "result",
      "port": "value"
    },
    {
      "name": "answer",
      "node": "model",
      "port": "delta",
      "optional": true
    }
  ]
}
