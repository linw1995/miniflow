{
  "version": "2026-11-13",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "context": {
            "type": "object",
            "default": {
              "title": {
                "source": "provisional",
                "revision": 0,
                "attempted": false,
                "enabled": true
              }
            }
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY",
            "default": ""
          }
        }
      }
    },
    {
      "id": "model",
      "kind": "builtin.llm",
      "config": {
        "model": {
          "$ref": "params.model"
        },
        "base_url": {
          "$ref": "params.base_url"
        },
        "api_key": {
          "$ref": "params.api_key"
        },
        "capture_errors": true,
        "attribution": {
          "purpose": "conversation"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "conversation_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "succeeded",
            "condition": {
              "source": {
                "output": "model.status",
                "path": ""
              },
              "operator": "eq",
              "value": "succeeded"
            }
          }
        ]
      }
    },
    {
      "id": "append",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "messages": {
            "list": "object"
          },
          "message": "object"
        },
        "code": {
          "value": "messages + [dyn(message)]"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        },
        "message": {
          "from": {
            "node": "model",
            "port": "message"
          }
        }
      }
    },
    {
      "id": "unchanged",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "messages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "node": "append",
              "port": "value"
            },
            {
              "node": "unchanged",
              "port": "value"
            }
          ]
        }
      }
    },
    {
      "id": "eligible",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "context": "object",
          "status": "string"
        },
        "code": {
          "value": "status == 'succeeded' && context.title.enabled && context.title.source == 'provisional' && !context.title.attempted"
        }
      },
      "inputs": {
        "context": {
          "from": {
            "node": "params",
            "port": "context"
          }
        },
        "status": {
          "from": {
            "node": "model",
            "port": "status"
          }
        }
      }
    },
    {
      "id": "title_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "eligible.value",
                "path": ""
              },
              "operator": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "title_prompt",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "messages": {
            "list": "object"
          },
          "text": "string"
        },
        "code": {
          "value": "'user: ' + string(messages[size(messages) - 1].content) + '\\nassistant: ' + text"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        },
        "text": {
          "from": {
            "node": "model",
            "port": "text"
          }
        }
      }
    },
    {
      "id": "title_system",
      "kind": "builtin.constant",
      "config": {
        "value": "Summarize this conversation as a concise single-line title in its language. Return only the title, at most 120 characters."
      }
    },
    {
      "id": "title_model_messages",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "prompt": "string",
          "system": "string"
        },
        "code": {
          "messages": "[{'role':'system','content':system}, {'role':'user','content':prompt}]"
        }
      },
      "inputs": {
        "prompt": {
          "from": {
            "node": "title_prompt",
            "port": "value"
          }
        },
        "system": {
          "from": {
            "node": "title_system",
            "port": "value"
          }
        }
      }
    },
    {
      "id": "title_model",
      "kind": "builtin.llm",
      "config": {
        "model": {
          "$ref": "params.model"
        },
        "base_url": {
          "$ref": "params.base_url"
        },
        "api_key": {
          "$ref": "params.api_key"
        },
        "capture_errors": true,
        "attribution": {
          "purpose": "title"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "title_model_messages",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "combined_usages",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "left": {
            "list": "object"
          },
          "right": {
            "list": "object"
          }
        },
        "code": {
          "value": "left + right"
        }
      },
      "inputs": {
        "left": {
          "from": {
            "node": "model",
            "port": "usages"
          }
        },
        "right": {
          "from": {
            "node": "title_model",
            "port": "usages"
          }
        }
      }
    },
    {
      "id": "conversation_usages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "model",
            "port": "usages"
          }
        }
      }
    },
    {
      "id": "usages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "node": "combined_usages",
              "port": "value"
            },
            {
              "node": "conversation_usages",
              "port": "value"
            }
          ]
        }
      }
    },
    {
      "id": "title_success",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "title_model.status",
                "path": ""
              },
              "operator": "eq",
              "value": "succeeded"
            }
          }
        ]
      }
    },
    {
      "id": "title",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "title_model",
            "port": "text"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "model",
      "to_node": "conversation_route"
    },
    {
      "from_node": "conversation_route",
      "from_output": "succeeded",
      "to_node": "append"
    },
    {
      "from_node": "conversation_route",
      "from_output": "else",
      "to_node": "unchanged"
    },
    {
      "from_node": "eligible",
      "to_node": "title_route"
    },
    {
      "from_node": "title_route",
      "from_output": "yes",
      "to_node": "title_prompt"
    },
    {
      "from_node": "title_route",
      "from_output": "else",
      "to_node": "conversation_usages"
    },
    {
      "from_node": "title_model",
      "to_node": "title_success"
    },
    {
      "from_node": "title_success",
      "from_output": "yes",
      "to_node": "title"
    }
  ],
  "outputs": [
    {
      "name": "status",
      "node": "model",
      "port": "status"
    },
    {
      "name": "text",
      "node": "model",
      "port": "text"
    },
    {
      "name": "messages",
      "node": "messages",
      "port": "value"
    },
    {
      "name": "metadata",
      "node": "model",
      "port": "metadata",
      "optional": true
    },
    {
      "name": "finish_reason",
      "node": "model",
      "port": "finish_reason",
      "optional": true
    },
    {
      "name": "usages",
      "node": "usages",
      "port": "value"
    },
    {
      "name": "error",
      "node": "model",
      "port": "error",
      "optional": true
    },
    {
      "name": "title",
      "node": "title",
      "port": "value",
      "optional": true
    },
    {
      "name": "answer",
      "node": "model",
      "port": "delta",
      "optional": true
    }
  ],
  "clusters": [
    {
      "label": "Conversation",
      "annotation": "Resolve inputs and generate the primary response before deciding whether a title is needed.",
      "nodes": [
        "params",
        "model",
        "conversation_route",
        "append",
        "unchanged",
        "messages"
      ]
    },
    {
      "label": "Title eligibility",
      "annotation": "Generate a title only after a successful response when the provisional title allows an attempt.",
      "nodes": [
        "eligible",
        "title_route"
      ]
    },
    {
      "label": "Title generation",
      "annotation": "Build the title prompt, call the title model, and expose the title only when that call succeeds.",
      "nodes": [
        "title_prompt",
        "title_system",
        "title_model_messages",
        "title_model",
        "title_success",
        "title"
      ]
    },
    {
      "label": "Usage accounting",
      "annotation": "Combine conversation and title usage, or preserve conversation usage when title generation is skipped.",
      "nodes": [
        "combined_usages",
        "conversation_usages",
        "usages"
      ]
    }
  ]
}
