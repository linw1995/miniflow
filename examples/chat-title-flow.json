{
  "version": "2026-11-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "context": {
            "type": "object",
            "default": {
              "title": {
                "source": "provisional",
                "revision": 0,
                "attempted": false,
                "enabled": true
              },
              "model_context": {
                "revision": 0
              }
            }
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY",
            "default": ""
          }
        }
      }
    },
    {
      "id": "model",
      "kind": "builtin.llm",
      "config": {
        "model": {
          "$ref": "params.model"
        },
        "capture_errors": true,
        "attribution": {
          "purpose": "conversation"
        },
        "base_url": {
          "$ref": "params.base_url"
        },
        "api_key": {
          "$ref": "params.api_key"
        }
      },
      "inputs": {
        "messages": {
          "$ref": "params.messages"
        }
      }
    },
    {
      "id": "eligible",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "context": "object",
          "status": "string"
        },
        "code": {
          "value": "status == 'succeeded' && context.title.enabled && context.title.source == 'provisional' && !context.title.attempted"
        }
      },
      "inputs": {
        "context": {
          "$ref": "params.context"
        },
        "status": {
          "$ref": "model.status"
        }
      }
    },
    {
      "id": "title_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "eligible.value",
                "path": ""
              },
              "operator": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "title_prompt",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "messages": {
            "list": "object"
          },
          "text": "string"
        },
        "code": {
          "messages": "[{'role':'system','content':'Summarize this conversation as a concise single-line title in its language. Return only the title, at most 120 characters.'}, {'role':'user','content':'user: ' + messages[messages.size() - 1].content + '\\nassistant: ' + text}]"
        }
      },
      "inputs": {
        "messages": {
          "$ref": "params.messages"
        },
        "text": {
          "$ref": "model.text"
        }
      }
    },
    {
      "id": "title_model",
      "kind": "builtin.llm",
      "config": {
        "model": {
          "$ref": "params.model"
        },
        "capture_errors": true,
        "attribution": {
          "purpose": "title"
        },
        "base_url": {
          "$ref": "params.base_url"
        },
        "api_key": {
          "$ref": "params.api_key"
        }
      },
      "inputs": {
        "messages": {
          "$ref": "title_prompt.messages"
        }
      }
    },
    {
      "id": "combined_usages",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "left": {
            "list": "object"
          },
          "right": {
            "list": "object"
          }
        },
        "code": {
          "value": "left + right"
        }
      },
      "inputs": {
        "left": {
          "$ref": "model.usages"
        },
        "right": {
          "$ref": "title_model.usages"
        }
      }
    },
    {
      "id": "conversation_usages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "$ref": "model.usages"
        }
      }
    },
    {
      "id": "usages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "combined_usages.value"
            },
            {
              "$ref": "conversation_usages.value"
            }
          ]
        }
      }
    },
    {
      "id": "title_success",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "title_model.status",
                "path": ""
              },
              "operator": "eq",
              "value": "succeeded"
            }
          }
        ]
      }
    },
    {
      "id": "title",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "$ref": "title_model.text"
        }
      }
    },
    {
      "id": "failed_title",
      "kind": "builtin.constant",
      "config": {
        "value": ""
      }
    },
    {
      "id": "skipped_title",
      "kind": "builtin.constant",
      "config": {
        "value": ""
      }
    },
    {
      "id": "title_value",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "title.value"
            },
            {
              "$ref": "failed_title.value"
            },
            {
              "$ref": "skipped_title.value"
            }
          ]
        }
      }
    },
    {
      "id": "result",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "status": "string",
          "messages": {
            "list": "object"
          },
          "primary_usages": {
            "list": "object"
          },
          "usages": {
            "list": "object"
          },
          "title": "string"
        },
        "code": {
          "value": "title == '' ? {'status':dyn(status),'messages':dyn(messages),'usages':dyn(usages),'error':dyn(status == 'failed' ? primary_usages[0].error : '')} : {'status':dyn(status),'messages':dyn(messages),'usages':dyn(usages),'error':dyn(''),'title':dyn(title)}"
        }
      },
      "inputs": {
        "status": {
          "$ref": "model.status"
        },
        "messages": {
          "$ref": "model.messages"
        },
        "primary_usages": {
          "$ref": "model.usages"
        },
        "usages": {
          "$ref": "usages.value"
        },
        "title": {
          "$ref": "title_value.value"
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "eligible",
      "to_node": "title_route"
    },
    {
      "from_node": "title_route",
      "from_output": "yes",
      "to_node": "title_prompt"
    },
    {
      "from_node": "title_route",
      "from_output": "else",
      "to_node": "conversation_usages"
    },
    {
      "from_node": "title_route",
      "from_output": "else",
      "to_node": "skipped_title"
    },
    {
      "from_node": "title_model",
      "to_node": "title_success"
    },
    {
      "from_node": "title_success",
      "from_output": "yes",
      "to_node": "title"
    },
    {
      "from_node": "title_success",
      "from_output": "else",
      "to_node": "failed_title"
    }
  ],
  "clusters": [
    {
      "label": "Conversation",
      "annotation": "Resolve inputs and generate the primary response before deciding whether a title is needed.",
      "nodes": [
        "params",
        "model"
      ]
    },
    {
      "label": "Title eligibility",
      "annotation": "Generate a title only after a successful response when the provisional title allows an attempt.",
      "nodes": [
        "eligible",
        "title_route"
      ]
    },
    {
      "label": "Title generation",
      "annotation": "Build the title request and retain whether the optional attempt succeeded, failed, or was skipped.",
      "nodes": [
        "title_prompt",
        "title_model",
        "title_success",
        "title",
        "failed_title",
        "skipped_title",
        "title_value"
      ]
    },
    {
      "label": "Usage accounting",
      "annotation": "Combine conversation and optional title usage in the self-contained append result.",
      "nodes": [
        "combined_usages",
        "conversation_usages",
        "usages",
        "result"
      ]
    }
  ],
  "outputs": [
    {
      "name": "append",
      "node": "result",
      "port": "value"
    },
    {
      "name": "answer",
      "node": "model",
      "port": "delta",
      "optional": true
    }
  ]
}
