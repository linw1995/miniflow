{
  "version": "2026-11-13",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY",
            "default": ""
          }
        }
      }
    },
    {
      "id": "repeat",
      "kind": "loop.run",
      "config": {
        "max_iterations": 2,
        "inputs": {
          "model": "string",
          "base_url": "string",
          "api_key": "string"
        },
        "variables": [
          {
            "name": "messages",
            "type": {
              "list": "object"
            }
          },
          {
            "name": "generated",
            "type": {
              "list": "object"
            },
            "initial": []
          },
          {
            "name": "usages",
            "type": {
              "list": "object"
            },
            "initial": []
          },
          {
            "name": "status",
            "type": "string",
            "initial": "succeeded"
          },
          {
            "name": "error",
            "type": "string",
            "initial": ""
          }
        ],
        "until": {
          "variable": "status",
          "operator": "eq",
          "value": "failed"
        },
        "body": {
          "version": "2026-11-13",
          "dependencies": {},
          "nodes": [
            {
              "id": "chat",
              "kind": "builtin.llm",
              "config": {
                "model": {
                  "$ref": "%loop.model"
                },
                "base_url": {
                  "$ref": "%loop.base_url"
                },
                "api_key": {
                  "$ref": "%loop.api_key"
                },
                "capture_errors": true
              },
              "inputs": {
                "messages": {
                  "from": {
                    "node": "%loop",
                    "port": "messages"
                  }
                }
              }
            },
            {
              "id": "collect",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "request": {
                    "list": "object"
                  },
                  "generated": {
                    "list": "object"
                  },
                  "additions": {
                    "list": "object"
                  },
                  "left": {
                    "list": "object"
                  },
                  "right": {
                    "list": "object"
                  },
                  "status": "string"
                },
                "code": {
                  "messages": "request + additions",
                  "generated": "generated + additions.map(message, {'role':dyn(message.role),'content':dyn(message.content),'metadata':dyn({'strategy':'iterative'})})",
                  "usages": "left + right",
                  "error": "status == 'failed' ? right[0].error : ''"
                }
              },
              "inputs": {
                "request": {
                  "from": {
                    "node": "%loop",
                    "port": "messages"
                  }
                },
                "generated": {
                  "from": {
                    "node": "%loop",
                    "port": "generated"
                  }
                },
                "additions": {
                  "from": {
                    "node": "chat",
                    "port": "messages"
                  }
                },
                "left": {
                  "from": {
                    "node": "%loop",
                    "port": "usages"
                  }
                },
                "right": {
                  "from": {
                    "node": "chat",
                    "port": "usages"
                  }
                },
                "status": {
                  "from": {
                    "node": "chat",
                    "port": "status"
                  }
                }
              }
            }
          ],
          "clusters": [
            {
              "label": "Generate and retain",
              "annotation": "Accumulate generated messages and usage while carrying the complete request context between iterations.",
              "nodes": [
                "chat",
                "collect"
              ]
            }
          ],
          "outputs": [
            {
              "name": "messages",
              "node": "collect",
              "port": "messages"
            },
            {
              "name": "generated",
              "node": "collect",
              "port": "generated"
            },
            {
              "name": "usages",
              "node": "collect",
              "port": "usages"
            },
            {
              "name": "status",
              "node": "chat",
              "port": "status"
            },
            {
              "name": "error",
              "node": "collect",
              "port": "error"
            }
          ]
        },
        "stream_outputs": {
          "answer": {
            "node": "chat",
            "port": "delta"
          }
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        },
        "model": {
          "from": {
            "node": "params",
            "port": "model"
          }
        },
        "base_url": {
          "from": {
            "node": "params",
            "port": "base_url"
          }
        },
        "api_key": {
          "from": {
            "node": "params",
            "port": "api_key"
          }
        }
      }
    },
    {
      "id": "result",
      "kind": "builtin.object",
      "config": {
        "fields": {
          "status": "string",
          "messages": {
            "list": "object"
          },
          "usages": {
            "list": "object"
          },
          "error": "string"
        }
      },
      "inputs": {
        "status": {
          "from": {
            "node": "repeat",
            "port": "status"
          }
        },
        "messages": {
          "from": {
            "node": "repeat",
            "port": "generated"
          }
        },
        "usages": {
          "from": {
            "node": "repeat",
            "port": "usages"
          }
        },
        "error": {
          "from": {
            "node": "repeat",
            "port": "error"
          }
        }
      }
    }
  ],
  "clusters": [
    {
      "label": "Conversation setup",
      "annotation": "Resolve the admitted messages and model configuration.",
      "nodes": [
        "params"
      ]
    },
    {
      "label": "Repeated conversation",
      "annotation": "Run two model calls and retain all generated additions and usage.",
      "nodes": [
        "repeat"
      ]
    },
    {
      "label": "Terminal result",
      "annotation": "Export one append result without echoing the admitted request prefix.",
      "nodes": [
        "result"
      ]
    }
  ],
  "outputs": [
    {
      "name": "append",
      "node": "result",
      "port": "value"
    },
    {
      "name": "answer",
      "node": "repeat",
      "port": "answer",
      "optional": true
    }
  ]
}
