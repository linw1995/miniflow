{
  "version": "2026-10-23",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "MODEL_API_KEY"
          },
          "prompt": {
            "type": "string"
          },
          "system": {
            "type": "string",
            "default": ""
          },
          "history": {
            "type": {
              "list": "object"
            },
            "default": []
          }
        }
      }
    },
    {
      "id": "annotation",
      "kind": "builtin.constant",
      "config": {
        "value": {
          "strategy": "iterative"
        }
      }
    },
    {
      "id": "empty_usages",
      "kind": "builtin.constant",
      "config": {
        "value": []
      }
    },
    {
      "id": "initial_status",
      "kind": "builtin.constant",
      "config": {
        "value": "succeeded"
      }
    },
    {
      "id": "empty_text",
      "kind": "builtin.constant",
      "config": {
        "value": ""
      }
    },
    {
      "id": "repeat",
      "kind": "workflow.loop",
      "loop": {
        "max_iterations": 2,
        "variables": [
          {
            "name": "prompt",
            "type": "string"
          },
          {
            "name": "system",
            "type": "string"
          },
          {
            "name": "history",
            "type": {
              "list": "object"
            }
          },
          {
            "name": "usages",
            "type": {
              "list": "object"
            }
          },
          {
            "name": "status",
            "type": "string"
          },
          {
            "name": "text",
            "type": "string"
          },
          {
            "name": "error",
            "type": "string"
          },
          {
            "name": "model",
            "type": "string"
          },
          {
            "name": "base_url",
            "type": "string"
          },
          {
            "name": "api_key",
            "type": "string"
          }
        ],
        "until": {
          "variable": "status",
          "operator": "eq",
          "value": "failed"
        },
        "body": {
          "nodes": [
            {
              "id": "chat",
              "kind": "builtin.llm",
              "config": {
                "model": {
                  "$ref": "%loop.model"
                },
                "base_url": {
                  "$ref": "%loop.base_url"
                },
                "api_key": {
                  "$ref": "%loop.api_key"
                },
                "capture_errors": true
              },
              "inputs": {
                "messages": {
                  "from": {
                    "node": "chat_messages",
                    "port": "messages"
                  }
                }
              }
            },
            {
              "id": "collect",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "left": {
                    "list": "object"
                  },
                  "right": {
                    "list": "object"
                  }
                },
                "code": {
                  "value": "left + right"
                }
              },
              "inputs": {
                "left": {
                  "from": {
                    "node": "%loop",
                    "port": "usages"
                  }
                },
                "right": {
                  "from": {
                    "node": "chat",
                    "port": "usages"
                  }
                }
              }
            },
            {
              "id": "save_history",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "history"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "chat_history",
                    "port": "value"
                  }
                }
              }
            },
            {
              "id": "save_usages",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "usages"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "collect",
                    "port": "value"
                  }
                }
              }
            },
            {
              "id": "save_status",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "status"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "chat",
                    "port": "status"
                  }
                }
              }
            },
            {
              "id": "save_text",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "text"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "chat",
                    "port": "text"
                  }
                }
              }
            },
            {
              "id": "save_error",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "error"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "chat",
                    "port": "error"
                  }
                }
              }
            },
            {
              "id": "chat_messages",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "prompt": "string",
                  "history": {
                    "list": "object"
                  },
                  "system": "string"
                },
                "code": {
                  "messages": "(system == '' ? [] : [{'role':'system','content':system}]) + history + [{'role':'user','content':prompt}]",
                  "history": "history + [{'role':'user','content':prompt}]"
                }
              },
              "inputs": {
                "prompt": {
                  "from": {
                    "node": "%loop",
                    "port": "prompt"
                  }
                },
                "history": {
                  "from": {
                    "node": "%loop",
                    "port": "history"
                  }
                },
                "system": {
                  "from": {
                    "node": "%loop",
                    "port": "system"
                  }
                }
              }
            },
            {
              "id": "chat_history",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "history": {
                    "list": "object"
                  },
                  "message": "object"
                },
                "code": {
                  "value": "history + [message]"
                }
              },
              "inputs": {
                "history": {
                  "from": {
                    "node": "chat_messages",
                    "port": "history"
                  }
                },
                "message": {
                  "from": {
                    "node": "chat",
                    "port": "message"
                  }
                }
              }
            }
          ],
          "clusters": [
            {
              "label": "Generate and account",
              "annotation": "Generate one reply and append the call usage to the accumulated usage list.",
              "nodes": [
                "chat",
                "collect",
                "chat_messages",
                "chat_history"
              ]
            },
            {
              "label": "Persist turn state",
              "annotation": "Carry history, usage, status, text, and errors into the next loop iteration.",
              "nodes": [
                "save_history",
                "save_usages",
                "save_status",
                "save_text",
                "save_error"
              ]
            }
          ]
        }
      },
      "inputs": {
        "prompt": {
          "from": {
            "node": "params",
            "port": "prompt"
          }
        },
        "system": {
          "from": {
            "node": "params",
            "port": "system"
          }
        },
        "history": {
          "from": {
            "node": "params",
            "port": "history"
          }
        },
        "usages": {
          "from": {
            "node": "empty_usages",
            "port": "value"
          }
        },
        "status": {
          "from": {
            "node": "initial_status",
            "port": "value"
          }
        },
        "text": {
          "from": {
            "node": "empty_text",
            "port": "value"
          }
        },
        "error": {
          "from": {
            "node": "empty_text",
            "port": "value"
          }
        },
        "model": {
          "from": {
            "node": "params",
            "port": "model"
          }
        },
        "base_url": {
          "from": {
            "node": "params",
            "port": "base_url"
          }
        },
        "api_key": {
          "from": {
            "node": "params",
            "port": "api_key"
          }
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "status",
      "node": "repeat",
      "port": "status"
    },
    {
      "name": "text",
      "node": "repeat",
      "port": "text"
    },
    {
      "name": "usages",
      "node": "repeat",
      "port": "usages"
    },
    {
      "name": "error",
      "node": "repeat",
      "port": "error"
    },
    {
      "name": "metadata",
      "node": "annotation",
      "port": "value"
    }
  ],
  "clusters": [
    {
      "label": "Conversation setup",
      "annotation": "Resolve model settings and initialize the loop state and response metadata.",
      "nodes": [
        "params",
        "annotation",
        "empty_usages",
        "initial_status",
        "empty_text"
      ]
    },
    {
      "label": "Repeated conversation",
      "annotation": "Run two conversation turns, carrying history and accumulating usage across iterations.",
      "nodes": [
        "repeat"
      ]
    }
  ]
}
