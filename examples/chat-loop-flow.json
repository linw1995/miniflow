{
  "version": "2026-10-03",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "MODEL_API_KEY"
          },
          "prompt": {
            "type": "string"
          },
          "system": {
            "type": "string",
            "default": ""
          },
          "history": {
            "type": {
              "list": "object"
            },
            "default": []
          }
        }
      }
    },
    {
      "id": "annotation",
      "kind": "builtin.constant",
      "config": {
        "value": {
          "strategy": "iterative"
        }
      }
    },
    {
      "id": "empty_usages",
      "kind": "builtin.constant",
      "config": {
        "value": []
      }
    },
    {
      "id": "initial_status",
      "kind": "builtin.constant",
      "config": {
        "value": "succeeded"
      }
    },
    {
      "id": "empty_text",
      "kind": "builtin.constant",
      "config": {
        "value": ""
      }
    },
    {
      "id": "repeat",
      "kind": "workflow.loop",
      "loop": {
        "max_iterations": 2,
        "variables": [
          {
            "name": "prompt",
            "type": "string"
          },
          {
            "name": "system",
            "type": "string"
          },
          {
            "name": "history",
            "type": {
              "list": "object"
            }
          },
          {
            "name": "usages",
            "type": {
              "list": "object"
            }
          },
          {
            "name": "status",
            "type": "string"
          },
          {
            "name": "text",
            "type": "string"
          },
          {
            "name": "error",
            "type": "string"
          },
          {
            "name": "model",
            "type": "string"
          },
          {
            "name": "base_url",
            "type": "string"
          },
          {
            "name": "api_key",
            "type": "string"
          }
        ],
        "until": {
          "variable": "status",
          "operator": "eq",
          "value": "failed"
        },
        "body": {
          "nodes": [
            {
              "id": "chat",
              "kind": "builtin.llm",
              "config": {
                "model": {
                  "$ref": "%loop.model"
                },
                "base_url": {
                  "$ref": "%loop.base_url"
                },
                "api_key": {
                  "$ref": "%loop.api_key"
                },
                "capture_errors": true
              }
            },
            {
              "id": "collect",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "left": {
                    "list": "object"
                  },
                  "right": {
                    "list": "object"
                  }
                },
                "code": {
                  "value": "left + right"
                }
              }
            },
            {
              "id": "save_history",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "history"
              }
            },
            {
              "id": "save_usages",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "usages"
              }
            },
            {
              "id": "save_status",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "status"
              }
            },
            {
              "id": "save_text",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "text"
              }
            },
            {
              "id": "save_error",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "error"
              }
            }
          ],
          "edges": [
            {
              "from_node": "%loop",
              "from_output": "prompt",
              "to_node": "chat",
              "to_input": "prompt"
            },
            {
              "from_node": "%loop",
              "from_output": "system",
              "to_node": "chat",
              "to_input": "system"
            },
            {
              "from_node": "%loop",
              "from_output": "history",
              "to_node": "chat",
              "to_input": "history"
            },
            {
              "from_node": "%loop",
              "from_output": "usages",
              "to_node": "collect",
              "to_input": "left"
            },
            {
              "from_node": "chat",
              "from_output": "usages",
              "to_node": "collect",
              "to_input": "right"
            },
            {
              "from_node": "chat",
              "from_output": "history",
              "to_node": "save_history",
              "to_input": "value"
            },
            {
              "from_node": "collect",
              "from_output": "value",
              "to_node": "save_usages",
              "to_input": "value"
            },
            {
              "from_node": "chat",
              "from_output": "status",
              "to_node": "save_status",
              "to_input": "value"
            },
            {
              "from_node": "chat",
              "from_output": "text",
              "to_node": "save_text",
              "to_input": "value"
            },
            {
              "from_node": "chat",
              "from_output": "error",
              "to_node": "save_error",
              "to_input": "value"
            }
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "params",
      "from_output": "prompt",
      "to_node": "repeat",
      "to_input": "prompt"
    },
    {
      "from_node": "params",
      "from_output": "system",
      "to_node": "repeat",
      "to_input": "system"
    },
    {
      "from_node": "params",
      "from_output": "history",
      "to_node": "repeat",
      "to_input": "history"
    },
    {
      "from_node": "empty_usages",
      "from_output": "value",
      "to_node": "repeat",
      "to_input": "usages"
    },
    {
      "from_node": "initial_status",
      "from_output": "value",
      "to_node": "repeat",
      "to_input": "status"
    },
    {
      "from_node": "empty_text",
      "from_output": "value",
      "to_node": "repeat",
      "to_input": "text"
    },
    {
      "from_node": "empty_text",
      "from_output": "value",
      "to_node": "repeat",
      "to_input": "error"
    },
    {
      "from_node": "params",
      "from_output": "model",
      "to_node": "repeat",
      "to_input": "model"
    },
    {
      "from_node": "params",
      "from_output": "base_url",
      "to_node": "repeat",
      "to_input": "base_url"
    },
    {
      "from_node": "params",
      "from_output": "api_key",
      "to_node": "repeat",
      "to_input": "api_key"
    }
  ],
  "outputs": [
    {
      "name": "status",
      "node": "repeat",
      "port": "status"
    },
    {
      "name": "text",
      "node": "repeat",
      "port": "text"
    },
    {
      "name": "usages",
      "node": "repeat",
      "port": "usages"
    },
    {
      "name": "error",
      "node": "repeat",
      "port": "error"
    },
    {
      "name": "metadata",
      "node": "annotation",
      "port": "value"
    }
  ]
}
