{
  "version": "2026-11-13",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY",
            "default": ""
          }
        }
      }
    },
    {
      "id": "repeat",
      "kind": "loop.run",
      "config": {
        "max_iterations": 2,
        "inputs": {
          "model": "string",
          "base_url": "string",
          "api_key": "string"
        },
        "variables": [
          {
            "name": "messages",
            "type": {
              "list": "object"
            }
          },
          {
            "name": "usages",
            "type": {
              "list": "object"
            },
            "initial": []
          },
          {
            "name": "text",
            "type": "string",
            "initial": ""
          },
          {
            "name": "status",
            "type": "string",
            "initial": "succeeded"
          },
          {
            "name": "error",
            "type": "string",
            "initial": ""
          }
        ],
        "until": {
          "variable": "status",
          "operator": "eq",
          "value": "failed"
        },
        "body": {
          "version": "2026-11-13",
          "dependencies": {},
          "nodes": [
            {
              "id": "chat",
              "kind": "builtin.llm",
              "config": {
                "model": {
                  "$ref": "%loop.model"
                },
                "base_url": {
                  "$ref": "%loop.base_url"
                },
                "api_key": {
                  "$ref": "%loop.api_key"
                },
                "capture_errors": true
              },
              "inputs": {
                "messages": {
                  "from": {
                    "node": "%loop",
                    "port": "messages"
                  }
                }
              }
            },
            {
              "id": "append",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "messages": {
                    "list": "object"
                  },
                  "message": "object"
                },
                "code": {
                  "value": "messages + [dyn(message)]"
                }
              },
              "inputs": {
                "messages": {
                  "from": {
                    "node": "%loop",
                    "port": "messages"
                  }
                },
                "message": {
                  "from": {
                    "node": "chat",
                    "port": "message"
                  }
                }
              }
            },
            {
              "id": "usages",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "left": {
                    "list": "object"
                  },
                  "right": {
                    "list": "object"
                  }
                },
                "code": {
                  "value": "left + right"
                }
              },
              "inputs": {
                "left": {
                  "from": {
                    "node": "%loop",
                    "port": "usages"
                  }
                },
                "right": {
                  "from": {
                    "node": "chat",
                    "port": "usages"
                  }
                }
              }
            }
          ],
          "outputs": [
            {
              "name": "messages",
              "node": "append",
              "port": "value",
              "optional": true
            },
            {
              "name": "usages",
              "node": "usages",
              "port": "value"
            },
            {
              "name": "text",
              "node": "chat",
              "port": "text"
            },
            {
              "name": "status",
              "node": "chat",
              "port": "status"
            },
            {
              "name": "error",
              "node": "chat",
              "port": "error",
              "optional": true
            }
          ]
        },
        "stream_outputs": {
          "answer": {
            "node": "chat",
            "port": "delta"
          }
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        },
        "model": {
          "from": {
            "node": "params",
            "port": "model"
          }
        },
        "base_url": {
          "from": {
            "node": "params",
            "port": "base_url"
          }
        },
        "api_key": {
          "from": {
            "node": "params",
            "port": "api_key"
          }
        }
      }
    },
    {
      "id": "metadata",
      "kind": "builtin.constant",
      "config": {
        "value": {
          "strategy": "iterative"
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "status",
      "node": "repeat",
      "port": "status"
    },
    {
      "name": "text",
      "node": "repeat",
      "port": "text"
    },
    {
      "name": "messages",
      "node": "repeat",
      "port": "messages"
    },
    {
      "name": "usages",
      "node": "repeat",
      "port": "usages"
    },
    {
      "name": "error",
      "node": "repeat",
      "port": "error",
      "optional": true
    },
    {
      "name": "metadata",
      "node": "metadata",
      "port": "value"
    },
    {
      "name": "answer",
      "node": "repeat",
      "port": "answer",
      "optional": true
    }
  ]
}
