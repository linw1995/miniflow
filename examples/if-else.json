{
  "version": "2026-10-23",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    }
  },
  "nodes": [
    {
      "id": "load_order",
      "kind": "builtin.constant",
      "config": {
        "value": {
          "amount": 150
        }
      }
    },
    {
      "id": "audit",
      "kind": "builtin.constant",
      "config": {
        "value": false
      }
    },
    {
      "id": "route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "accepted",
            "condition": {
              "source": {
                "output": "load_order.value",
                "path": "/amount"
              },
              "operator": "gte",
              "value": 100
            }
          }
        ]
      }
    },
    {
      "id": "handle_accepted",
      "kind": "builtin.identity",
      "inputs": {
        "input": { "from": { "node": "load_order", "port": "value" } }
      }
    },
    {
      "id": "handle_else",
      "kind": "builtin.identity",
      "inputs": {
        "input": { "from": { "node": "load_order", "port": "value" } }
      }
    }
  ],
  "edges": [
    {
      "from_node": "load_order",
      "from_output": "value",
      "to_node": "audit"
    },
    {
      "from_node": "audit",
      "from_output": "value",
      "to_node": "route"
    },
    {
      "from_node": "route",
      "from_output": "accepted",
      "to_node": "handle_accepted"
    },
    {
      "from_node": "route",
      "from_output": "else",
      "to_node": "handle_else"
    }
  ],
  "outputs": [
    {
      "name": "accepted",
      "node": "handle_accepted",
      "port": "value",
      "optional": true
    },
    {
      "name": "else",
      "node": "handle_else",
      "port": "value",
      "optional": true
    }
  ],
  "clusters": [
    {
      "label": "Order evaluation",
      "annotation": "Load the order, complete the audit prerequisite, and choose the first matching amount branch.",
      "nodes": ["load_order", "audit", "route"]
    },
    {
      "label": "Branch results",
      "annotation": "Forward the order through the selected branch and omit outputs from skipped handlers.",
      "nodes": ["handle_accepted", "handle_else"]
    }
  ]
}
