{
  "version": "2026-10-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "api_key": {
            "type": "string",
            "secret": true
          },
          "base_url": {
            "type": "string",
            "secret": false
          },
          "search_description": {
            "type": "string",
            "secret": false
          },
          "search_parameters": {
            "type": "object",
            "secret": false
          },
          "fetch_description": {
            "type": "string",
            "secret": false
          },
          "fetch_parameters": {
            "type": "object",
            "secret": false
          }
        }
      }
    },
    {
      "id": "search",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "search.json"
        },
        "inputs": {
          "api_key": {
            "$ref": "params.api_key"
          },
          "base_url": {
            "$ref": "params.base_url"
          }
        }
      }
    },
    {
      "id": "fetch",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "fetch.json"
        },
        "inputs": {
          "api_key": {
            "$ref": "params.api_key"
          },
          "base_url": {
            "$ref": "params.base_url"
          }
        }
      }
    },
    {
      "id": "tool_properties",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "search_description": "string",
          "search_parameters": "object",
          "search_interface": "object",
          "fetch_description": "string",
          "fetch_parameters": "object",
          "fetch_interface": "object"
        },
        "code": {
          "value": "{\n  'search': {'description': search_description, 'parameters': search_parameters, 'interface': search_interface},\n  'fetch': {'description': fetch_description, 'parameters': fetch_parameters, 'interface': fetch_interface}\n}"
        }
      },
      "inputs": {
        "search_description": {
          "from": {
            "node": "params",
            "port": "search_description"
          }
        },
        "search_parameters": {
          "from": {
            "node": "params",
            "port": "search_parameters"
          }
        },
        "search_interface": {
          "from": {
            "node": "search",
            "port": "properties"
          }
        },
        "fetch_description": {
          "from": {
            "node": "params",
            "port": "fetch_description"
          }
        },
        "fetch_parameters": {
          "from": {
            "node": "params",
            "port": "fetch_parameters"
          }
        },
        "fetch_interface": {
          "from": {
            "node": "fetch",
            "port": "properties"
          }
        }
      }
    },
    {
      "id": "tools",
      "kind": "builtin.object",
      "config": {
        "fields": {
          "search": "flow",
          "fetch": "flow"
        }
      },
      "inputs": {
        "search": {
          "from": {
            "node": "search",
            "port": "value"
          }
        },
        "fetch": {
          "from": {
            "node": "fetch",
            "port": "value"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "params",
      "to_node": "search"
    },
    {
      "from_node": "params",
      "to_node": "fetch"
    }
  ],
  "outputs": [
    {
      "name": "tools",
      "node": "tools",
      "port": "value"
    },
    {
      "name": "tool_properties",
      "node": "tool_properties",
      "port": "value"
    }
  ]
}
