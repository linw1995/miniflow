{
  "version": "2026-11-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../../crates/builtin-nodes/core"
    },
    "deepseek": {
      "package": "mfn-deepseek",
      "path": "../../crates/builtin-nodes/deepseek"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "query": {
            "type": "string",
            "secret": false
          },
          "count": {
            "type": "uint",
            "default": 5,
            "secret": false
          },
          "api_key": {
            "type": "string",
            "secret": true
          },
          "base_url": {
            "type": "string",
            "secret": true
          }
        }
      }
    },
    {
      "id": "search",
      "kind": "builtin.deepseek.search",
      "config": {
        "api_key": {
          "$ref": "params.api_key"
        },
        "base_url": {
          "$ref": "params.base_url"
        }
      },
      "inputs": {
        "query": {
          "$ref": "params.query"
        },
        "count": {
          "$ref": "params.count"
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "results",
      "node": "search",
      "port": "results"
    }
  ]
}
