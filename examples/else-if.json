{
  "version": "2026-10-23",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    }
  },
  "nodes": [
    {
      "id": "load_order",
      "kind": "builtin.constant",
      "config": {
        "value": {
          "amount": 500
        }
      }
    },
    {
      "id": "audit",
      "kind": "builtin.constant",
      "config": {
        "value": false
      }
    },
    {
      "id": "route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "large",
            "condition": {
              "source": {
                "output": "load_order.value",
                "path": "/amount"
              },
              "operator": "gte",
              "value": 1000
            }
          },
          {
            "id": "medium",
            "condition": {
              "source": {
                "output": "load_order.value",
                "path": "/amount"
              },
              "operator": "gte",
              "value": 100
            }
          }
        ]
      }
    },
    {
      "id": "handle_large",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "load_order",
            "port": "value"
          }
        }
      }
    },
    {
      "id": "handle_medium",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "load_order",
            "port": "value"
          }
        }
      }
    },
    {
      "id": "handle_else",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "load_order",
            "port": "value"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "load_order",
      "from_output": "value",
      "to_node": "audit"
    },
    {
      "from_node": "audit",
      "from_output": "value",
      "to_node": "route"
    },
    {
      "from_node": "route",
      "from_output": "large",
      "to_node": "handle_large"
    },
    {
      "from_node": "route",
      "from_output": "medium",
      "to_node": "handle_medium"
    },
    {
      "from_node": "route",
      "from_output": "else",
      "to_node": "handle_else"
    }
  ],
  "outputs": [
    {
      "name": "large",
      "node": "handle_large",
      "port": "value",
      "optional": true
    },
    {
      "name": "medium",
      "node": "handle_medium",
      "port": "value",
      "optional": true
    },
    {
      "name": "else",
      "node": "handle_else",
      "port": "value",
      "optional": true
    }
  ],
  "clusters": [
    {
      "label": "Order evaluation",
      "annotation": "Load the order, complete the audit prerequisite, and choose the first matching amount branch.",
      "nodes": [
        "load_order",
        "audit",
        "route"
      ]
    },
    {
      "label": "Branch results",
      "annotation": "Forward the order through the selected branch and omit outputs from skipped handlers.",
      "nodes": [
        "handle_large",
        "handle_medium",
        "handle_else"
      ]
    }
  ]
}
