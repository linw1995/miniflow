{
  "version": "2026-10-23",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "repeat",
      "kind": "workflow.loop",
      "loop": {
        "max_iterations": 2,
        "variables": [
          {
            "name": "prompt",
            "type": "string"
          },
          {
            "name": "history",
            "type": {
              "list": "object"
            }
          },
          {
            "name": "text",
            "type": "string"
          }
        ],
        "body": {
          "nodes": [
            {
              "id": "chat",
              "kind": "builtin.llm",
              "config": {
                "model": "your-model",
                "api_key_env": "OPENAI_API_KEY"
              },
              "inputs": {
                "messages": {
                  "from": {
                    "node": "chat_messages",
                    "port": "messages"
                  }
                }
              }
            },
            {
              "id": "remember",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "history"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "chat_history",
                    "port": "value"
                  }
                }
              }
            },
            {
              "id": "answer",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "text"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "chat",
                    "port": "text"
                  }
                }
              }
            },
            {
              "id": "chat_messages",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "prompt": "string",
                  "history": {
                    "list": "object"
                  }
                },
                "code": {
                  "messages": "history + [dyn({'role':'user','content':prompt})]",
                  "history": "history + [dyn({'role':'user','content':prompt})]"
                }
              },
              "inputs": {
                "prompt": {
                  "from": {
                    "node": "%loop",
                    "port": "prompt"
                  }
                },
                "history": {
                  "from": {
                    "node": "%loop",
                    "port": "history"
                  }
                }
              }
            },
            {
              "id": "chat_history",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "history": {
                    "list": "object"
                  },
                  "message": "object"
                },
                "code": {
                  "value": "history + [message]"
                }
              },
              "inputs": {
                "history": {
                  "from": {
                    "node": "chat_messages",
                    "port": "history"
                  }
                },
                "message": {
                  "from": {
                    "node": "chat",
                    "port": "message"
                  }
                }
              }
            }
          ],
          "clusters": [
            {
              "label": "Conversation turn",
              "annotation": "Build request messages, call the model, and append the returned message to loop history.",
              "nodes": [
                "chat",
                "remember",
                "answer",
                "chat_messages",
                "chat_history"
              ]
            }
          ]
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "text",
      "node": "repeat",
      "port": "text"
    },
    {
      "name": "history",
      "node": "repeat",
      "port": "history"
    }
  ],
  "clusters": [
    {
      "label": "Conversation loop",
      "annotation": "Run two model calls while carrying conversation history and the latest answer.",
      "nodes": [
        "repeat"
      ]
    }
  ]
}
