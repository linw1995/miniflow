{
  "version": "2026-11-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "execution": {
    "limits": {
      "workers": 1
    }
  },
  "flows": {
    "finish": {
      "path": "agent-coding/finish.json"
    },
    "instructions": {
      "path": "agent-coding/instructions.json"
    },
    "request": {
      "path": "agent-coding/request.json"
    },
    "agent": {
      "builtin": "mfn-llm.agent"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "context": {
            "type": "object",
            "default": {}
          },
          "workspace_root": {
            "type": "string"
          },
          "load_instructions": {
            "type": "bool",
            "default": true
          },
          "user_instruction_dir": {
            "type": "string",
            "default": ""
          },
          "instruction_boundary": {
            "type": "string",
            "default": ""
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY"
          }
        }
      }
    },
    {
      "id": "instructions",
      "kind": "workflow.call",
      "config": {
        "flow": "instructions"
      },
      "inputs": {
        "params.workspace_root": {
          "$ref": "params.workspace_root"
        },
        "params.enabled": {
          "$ref": "params.load_instructions"
        },
        "params.user_dir": {
          "$ref": "params.user_instruction_dir"
        },
        "params.boundary": {
          "$ref": "params.instruction_boundary"
        }
      }
    },
    {
      "id": "request",
      "kind": "workflow.call",
      "config": {
        "flow": "request"
      },
      "inputs": {
        "params.instructions": {
          "$ref": "instructions.messages"
        },
        "params.workspace_root": {
          "$ref": "params.workspace_root"
        },
        "params.messages": {
          "$ref": "params.messages"
        }
      }
    },
    {
      "id": "read",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "coding-read.json"
        },
        "inputs": {
          "workspace_root": {
            "$ref": "params.workspace_root"
          }
        }
      }
    },
    {
      "id": "edit",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-coding/edit.json"
        },
        "inputs": {
          "workspace_root": {
            "$ref": "params.workspace_root"
          }
        }
      }
    },
    {
      "id": "write",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-coding/write.json"
        },
        "inputs": {
          "workspace_root": {
            "$ref": "params.workspace_root"
          }
        }
      }
    },
    {
      "id": "bash",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-coding/bash.json"
        },
        "inputs": {
          "workspace_root": {
            "$ref": "params.workspace_root"
          }
        }
      }
    },
    {
      "id": "grep",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-coding/grep.json"
        },
        "inputs": {
          "workspace_root": {
            "$ref": "params.workspace_root"
          }
        }
      }
    },
    {
      "id": "find",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-coding/find.json"
        },
        "inputs": {
          "workspace_root": {
            "$ref": "params.workspace_root"
          }
        }
      }
    },
    {
      "id": "ls",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-coding/ls.json"
        },
        "inputs": {
          "workspace_root": {
            "$ref": "params.workspace_root"
          }
        }
      }
    },
    {
      "id": "mkdir",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-coding/mkdir.json"
        },
        "inputs": {
          "workspace_root": {
            "$ref": "params.workspace_root"
          }
        }
      }
    },
    {
      "id": "tool_properties",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "mkdir_interface": "object",
          "ls_interface": "object",
          "find_interface": "object",
          "grep_interface": "object",
          "read_interface": "object",
          "edit_interface": "object",
          "write_interface": "object",
          "bash_interface": "object"
        },
        "code": {
          "value": "{\n  'ls': {'interface': ls_interface, 'description': 'List immediate nonignored files and directories under path (default .), including dotfiles. Returns workspace-relative paths and kinds in name order.'},\n  'find': {'interface': find_interface, 'description': 'Find files or directories by glob pattern under path (default .). Use *.rs for basenames or src/**/*.rs for scoped paths. kind is any, file, or directory; max_depth=1 selects immediate children.'},\n  'grep': {'interface': grep_interface, 'description': 'Search UTF-8 lines by regex pattern or literal text (literal=true). Optional path is a file or directory; defaults to the workspace root. Returns path, one-based line and text. Narrow the search if truncated.'},\n  'mkdir': {'interface': mkdir_interface, 'description': 'Create one new directory at path. Its parent must exist; an existing target is an error.'},\n  'read': {'interface': read_interface, 'description': 'Read a UTF-8 file by relative path. start_line is one-based; limit is at most 2000 lines. Continue at next_line if present.'},\n  'edit': {'interface': edit_interface, 'description': 'Edit an existing file by relative path. Supply edits as a list of objects with string fields old_text and new_text. Each old_text must match exactly once in the original file; matches may not overlap. All replacements apply together.'},\n  'write': {'interface': write_interface, 'description': 'Create a new UTF-8 file at a relative path with the supplied content. The parent directory must exist. Does not overwrite; use edit for existing files.'},\n  'bash': {'interface': bash_interface, 'description': 'Execute shell command text in the workspace. Each call starts a new non-interactive shell. Pipes, redirections, and multiple commands are supported. Optional timeout is in seconds. stdout and stderr contain diagnostic tails (up to 50 KiB or 2000 lines each). When truncated, stdout_path or stderr_path names the complete private log; inspect selected ranges with another shell command without rerunning the original.'}\n}"
        }
      },
      "inputs": {
        "mkdir_interface": {
          "$ref": "mkdir.properties"
        },
        "ls_interface": {
          "$ref": "ls.properties"
        },
        "find_interface": {
          "$ref": "find.properties"
        },
        "grep_interface": {
          "$ref": "grep.properties"
        },
        "read_interface": {
          "$ref": "read.properties"
        },
        "edit_interface": {
          "$ref": "edit.properties"
        },
        "write_interface": {
          "$ref": "write.properties"
        },
        "bash_interface": {
          "$ref": "bash.properties"
        }
      }
    },
    {
      "id": "tools",
      "kind": "builtin.object",
      "config": {
        "fields": {
          "mkdir": "flow",
          "ls": "flow",
          "find": "flow",
          "grep": "flow",
          "read": "flow",
          "edit": "flow",
          "write": "flow",
          "bash": "flow"
        }
      },
      "inputs": {
        "mkdir": {
          "$ref": "mkdir.value"
        },
        "ls": {
          "$ref": "ls.value"
        },
        "find": {
          "$ref": "find.value"
        },
        "grep": {
          "$ref": "grep.value"
        },
        "read": {
          "$ref": "read.value"
        },
        "edit": {
          "$ref": "edit.value"
        },
        "write": {
          "$ref": "write.value"
        },
        "bash": {
          "$ref": "bash.value"
        }
      }
    },
    {
      "id": "compact_policy",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-coding/compact.json"
        },
        "inputs": {
          "history": {
            "$ref": "params.messages"
          },
          "context": {
            "$ref": "params.context"
          },
          "workspace_root": {
            "$ref": "params.workspace_root"
          },
          "instructions": {
            "$ref": "instructions.messages"
          },
          "model": {
            "$ref": "params.model"
          },
          "base_url": {
            "$ref": "params.base_url"
          },
          "api_key": {
            "$ref": "params.api_key"
          }
        }
      }
    },
    {
      "id": "agent",
      "kind": "workflow.call",
      "config": {
        "flow": "agent"
      },
      "inputs": {
        "params.compact": {
          "$ref": "compact_policy.value"
        },
        "params.tools": {
          "$ref": "tools.value"
        },
        "params.tool_properties": {
          "$ref": "tool_properties.value"
        },
        "params.messages": {
          "$ref": "request.messages"
        },
        "params.model": {
          "$ref": "params.model"
        },
        "params.base_url": {
          "$ref": "params.base_url"
        },
        "params.api_key": {
          "$ref": "params.api_key"
        }
      }
    },
    {
      "id": "finish",
      "kind": "workflow.call",
      "config": {
        "flow": "finish"
      },
      "inputs": {
        "params.history": {
          "$ref": "params.messages"
        },
        "params.context": {
          "$ref": "params.context"
        },
        "params.workspace_root": {
          "$ref": "params.workspace_root"
        },
        "params.model": {
          "$ref": "params.model"
        },
        "params.base_url": {
          "$ref": "params.base_url"
        },
        "params.api_key": {
          "$ref": "params.api_key"
        },
        "params.generated": {
          "$ref": "agent.messages"
        },
        "params.checkpoint": {
          "$ref": "agent.checkpoint"
        },
        "params.status": {
          "$ref": "agent.status"
        },
        "params.usages": {
          "$ref": "agent.usages"
        },
        "params.error": {
          "$ref": "agent.error"
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "instructions",
      "to_node": "compact_policy"
    },
    {
      "from_node": "params",
      "to_node": "mkdir"
    },
    {
      "from_node": "params",
      "to_node": "ls"
    },
    {
      "from_node": "params",
      "to_node": "find"
    },
    {
      "from_node": "params",
      "to_node": "grep"
    },
    {
      "from_node": "params",
      "to_node": "read"
    },
    {
      "from_node": "params",
      "to_node": "edit"
    },
    {
      "from_node": "params",
      "to_node": "write"
    },
    {
      "from_node": "params",
      "to_node": "bash"
    }
  ],
  "outputs": [
    {
      "name": "tool_output",
      "node": "agent",
      "port": "tool_output",
      "optional": true
    },
    {
      "name": "tool_call_delta",
      "node": "agent",
      "port": "tool_call_delta",
      "optional": true
    },
    {
      "name": "answer",
      "node": "agent",
      "port": "answer",
      "optional": true
    },
    {
      "name": "append",
      "node": "finish",
      "port": "append",
      "optional": true
    },
    {
      "name": "replace_context",
      "node": "finish",
      "port": "replace_context",
      "optional": true
    }
  ]
}
