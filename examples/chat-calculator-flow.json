{
  "version": "2026-10-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "flows": {
    "agent": {
      "builtin": "mfn-llm.agent"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "steering": {
            "type": {
              "nullable": "object"
            },
            "default": null
          },
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY"
          }
        }
      }
    },
    {
      "id": "calculator",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-calculator/calculator.json"
        }
      }
    },
    {
      "id": "tool_properties",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "calculator_interface": "object"
        },
        "code": {
          "value": "{\n  'calculator': {\n    'description': 'Set operation to add, subtract, multiply, or divide on the numeric operands left and right. Division by zero returns an error message.',\n    'interface': calculator_interface\n  }\n}"
        }
      },
      "inputs": {
        "calculator_interface": {
          "from": {
            "node": "calculator",
            "port": "properties"
          }
        }
      }
    },
    {
      "id": "tools",
      "kind": "builtin.object",
      "config": {
        "fields": {
          "calculator": "flow"
        }
      },
      "inputs": {
        "calculator": {
          "from": {
            "node": "calculator",
            "port": "value"
          }
        }
      }
    },
    {
      "id": "agent",
      "kind": "workflow.call",
      "config": {
        "flow": "agent"
      },
      "inputs": {
        "params.tools": {
          "from": {
            "node": "tools",
            "port": "value"
          }
        },
        "params.steering": {
          "from": {
            "node": "params",
            "port": "steering"
          }
        },
        "params.messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        },
        "params.model": {
          "from": {
            "node": "params",
            "port": "model"
          }
        },
        "params.base_url": {
          "from": {
            "node": "params",
            "port": "base_url"
          }
        },
        "params.api_key": {
          "from": {
            "node": "params",
            "port": "api_key"
          }
        },
        "params.tool_properties": {
          "from": {
            "node": "tool_properties",
            "port": "value"
          }
        }
      }
    },
    {
      "id": "result",
      "kind": "builtin.object",
      "config": {
        "fields": {
          "status": "string",
          "messages": {
            "list": "object"
          },
          "usages": {
            "list": "object"
          },
          "error": "string"
        }
      },
      "inputs": {
        "status": {
          "from": {
            "node": "agent",
            "port": "status"
          }
        },
        "messages": {
          "from": {
            "node": "agent",
            "port": "messages"
          }
        },
        "usages": {
          "from": {
            "node": "agent",
            "port": "usages"
          }
        },
        "error": {
          "from": {
            "node": "agent",
            "port": "error"
          }
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "tool_call_delta",
      "node": "agent",
      "port": "tool_call_delta",
      "optional": true
    },
    {
      "name": "answer",
      "node": "agent",
      "port": "answer",
      "optional": true
    },
    {
      "name": "append",
      "node": "result",
      "port": "value"
    }
  ]
}
