{
  "version": "2026-10-03",
  "execution": {
    "mode": "stream"
  },
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "collect",
      "kind": "builtin.batch",
      "config": {
        "max_items": 3,
        "max_wait_ms": 250
      }
    },
    {
      "id": "consume",
      "kind": "builtin.identity"
    },
    {
      "id": "feed",
      "kind": "builtin.readline"
    },
    {
      "id": "convert",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": { "line": "string" },
        "code": { "item": "int(line)" }
      }
    }
  ],
  "edges": [
    {
      "from_node": "feed",
      "from_output": "line",
      "to_node": "convert",
      "to_input": "line"
    },
    {
      "from_node": "convert",
      "from_output": "item",
      "to_node": "collect",
      "to_input": "item"
    },
    {
      "from_node": "collect",
      "from_output": "items",
      "to_node": "consume",
      "to_input": "input"
    }
  ],
  "outputs": [
    {
      "name": "batch",
      "node": "consume",
      "port": "value"
    }
  ]
}
