{
  "version": "2026-10-23",
  "execution": {
    "mode": "stream"
  },
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "collect",
      "kind": "builtin.batch",
      "config": {
        "max_items": 3,
        "max_wait_ms": 250
      },
      "inputs": {
        "item": {
          "from": {
            "node": "convert",
            "port": "item"
          }
        }
      }
    },
    {
      "id": "consume",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "collect",
            "port": "items"
          }
        }
      }
    },
    {
      "id": "feed",
      "kind": "builtin.readline"
    },
    {
      "id": "convert",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "line": "string"
        },
        "code": {
          "item": "int(line)"
        }
      },
      "inputs": {
        "line": {
          "from": {
            "node": "feed",
            "port": "line"
          }
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "batch",
      "node": "consume",
      "port": "value"
    }
  ],
  "clusters": [
    {
      "label": "Read and convert",
      "annotation": "Read stdin lines and parse each line as an integer message.",
      "nodes": [
        "feed",
        "convert"
      ]
    },
    {
      "label": "Batch delivery",
      "annotation": "Collect integer messages until the size, timeout, or end-of-input flush and publish each batch.",
      "nodes": [
        "collect",
        "consume"
      ]
    }
  ]
}
