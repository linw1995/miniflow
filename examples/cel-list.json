{
  "version": "2026-10-23",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "source",
      "kind": "builtin.constant",
      "config": { "value": [1, 2] }
    },
    {
      "id": "transform",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": { "items": { "list": "int" } },
        "code": { "doubled": "items.map(x, x * 2)" }
      },
      "inputs": {
        "items": { "from": { "node": "source", "port": "value" } }
      }
    }
  ],
  "outputs": [
    { "name": "doubled", "node": "transform", "port": "doubled" }
  ],
  "clusters": [
    {
      "label": "List computation",
      "annotation": "Transform a typed list with CEL and return the resulting values.",
      "nodes": ["source", "transform"]
    }
  ]
}
