{
  "version": "2026-11-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "source",
      "kind": "builtin.constant",
      "config": {
        "value": [
          1,
          2,
          3
        ]
      }
    },
    {
      "id": "iteration",
      "kind": "builtin.iteration",
      "config": {
        "mode": "sequential",
        "on_error": "terminate",
        "body": {
          "version": "2026-11-28",
          "dependencies": {},
          "nodes": [
            {
              "id": "transform",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "item": "int",
                  "position": "int"
                },
                "code": {
                  "value": "item * 2 + position"
                }
              },
              "inputs": {
                "item": {
                  "$ref": "%iteration.item"
                },
                "position": {
                  "$ref": "%iteration.index"
                }
              }
            }
          ],
          "outputs": [
            {
              "name": "result",
              "node": "transform",
              "port": "value"
            }
          ],
          "clusters": [
            {
              "label": "Transform item",
              "annotation": "Double the current item and add its zero-based position.",
              "nodes": [
                "transform"
              ]
            }
          ]
        }
      },
      "inputs": {
        "items": {
          "$ref": "source.value"
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "results",
      "node": "iteration",
      "port": "results"
    }
  ],
  "clusters": [
    {
      "label": "Map input items",
      "annotation": "Run the body once per input item in order and collect its results.",
      "nodes": [
        "source",
        "iteration"
      ]
    }
  ]
}
