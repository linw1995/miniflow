{
  "version": "2026-11-13",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY",
            "default": ""
          }
        }
      }
    },
    {
      "id": "chat",
      "kind": "builtin.llm",
      "config": {
        "model": {
          "$ref": "params.model"
        },
        "base_url": {
          "$ref": "params.base_url"
        },
        "api_key": {
          "$ref": "params.api_key"
        },
        "capture_errors": true
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "succeeded",
            "condition": {
              "source": {
                "output": "chat.status",
                "path": ""
              },
              "operator": "eq",
              "value": "succeeded"
            }
          }
        ]
      }
    },
    {
      "id": "append",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "messages": {
            "list": "object"
          },
          "message": "object"
        },
        "code": {
          "value": "messages + [dyn(message)]"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        },
        "message": {
          "from": {
            "node": "chat",
            "port": "message"
          }
        }
      }
    },
    {
      "id": "unchanged",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "messages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "node": "append",
              "port": "value"
            },
            {
              "node": "unchanged",
              "port": "value"
            }
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "chat",
      "to_node": "route"
    },
    {
      "from_node": "route",
      "from_output": "succeeded",
      "to_node": "append"
    },
    {
      "from_node": "route",
      "from_output": "else",
      "to_node": "unchanged"
    }
  ],
  "outputs": [
    {
      "name": "status",
      "node": "chat",
      "port": "status"
    },
    {
      "name": "text",
      "node": "chat",
      "port": "text"
    },
    {
      "name": "messages",
      "node": "messages",
      "port": "value"
    },
    {
      "name": "usages",
      "node": "chat",
      "port": "usages"
    },
    {
      "name": "error",
      "node": "chat",
      "port": "error",
      "optional": true
    },
    {
      "name": "metadata",
      "node": "chat",
      "port": "metadata",
      "optional": true
    },
    {
      "name": "finish_reason",
      "node": "chat",
      "port": "finish_reason",
      "optional": true
    }
  ],
  "clusters": [
    {
      "label": "Conversation",
      "annotation": "Consume and return the same complete-message contract as the Agent.",
      "nodes": [
        "params",
        "chat",
        "route",
        "append",
        "unchanged",
        "messages"
      ]
    }
  ]
}
