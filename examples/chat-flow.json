{
  "version": "2026-10-23",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "MODEL_API_KEY"
          },
          "prompt": {
            "type": "string"
          },
          "system": {
            "type": "string",
            "default": ""
          },
          "history": {
            "type": {
              "list": "object"
            },
            "default": []
          }
        }
      }
    },
    {
      "id": "chat",
      "kind": "builtin.llm",
      "config": {
        "model": {
          "$ref": "params.model"
        },
        "base_url": {
          "$ref": "params.base_url"
        },
        "api_key": {
          "$ref": "params.api_key"
        },
        "capture_errors": true
      },
      "inputs": {
        "prompt": { "from": { "node": "params", "port": "prompt" } },
        "system": { "from": { "node": "params", "port": "system" } },
        "history": { "from": { "node": "params", "port": "history" } }
      }
    }
  ],
  "outputs": [
    {
      "name": "status",
      "node": "chat",
      "port": "status"
    },
    {
      "name": "text",
      "node": "chat",
      "port": "text"
    },
    {
      "name": "usages",
      "node": "chat",
      "port": "usages"
    },
    {
      "name": "error",
      "node": "chat",
      "port": "error",
      "optional": true
    },
    {
      "name": "metadata",
      "node": "chat",
      "port": "metadata",
      "optional": true
    },
    {
      "name": "finish_reason",
      "node": "chat",
      "port": "finish_reason",
      "optional": true
    }
  ],
  "clusters": [
    {
      "label": "Conversation",
      "annotation": "Resolve conversation parameters and produce one model response with captured errors and usage.",
      "nodes": ["params", "chat"]
    }
  ]
}
