{
  "version": "2026-11-13",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY",
            "default": ""
          }
        }
      }
    },
    {
      "id": "chat",
      "kind": "builtin.llm",
      "config": {
        "model": {
          "$ref": "params.model"
        },
        "base_url": {
          "$ref": "params.base_url"
        },
        "api_key": {
          "$ref": "params.api_key"
        },
        "capture_errors": true
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        }
      }
    },
    {
      "id": "error",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "status": "string",
          "usages": {
            "list": "object"
          }
        },
        "code": {
          "value": "status == 'failed' ? (usages.size() > 0 && has(usages[0].error) ? usages[0].error : 'Model call failed.') : ''"
        }
      },
      "inputs": {
        "status": {
          "from": {
            "node": "chat",
            "port": "status"
          }
        },
        "usages": {
          "from": {
            "node": "chat",
            "port": "usages"
          }
        }
      }
    },
    {
      "id": "result",
      "kind": "builtin.object",
      "config": {
        "fields": {
          "status": "string",
          "messages": {
            "list": "object"
          },
          "usages": {
            "list": "object"
          },
          "error": "string"
        }
      },
      "inputs": {
        "status": {
          "from": {
            "node": "chat",
            "port": "status"
          }
        },
        "messages": {
          "from": {
            "node": "chat",
            "port": "messages"
          }
        },
        "usages": {
          "from": {
            "node": "chat",
            "port": "usages"
          }
        },
        "error": {
          "from": {
            "node": "error",
            "port": "value"
          }
        }
      }
    }
  ],
  "clusters": [
    {
      "label": "Conversation",
      "annotation": "Resolve model parameters and produce an append result with captured errors and explicit usage.",
      "nodes": [
        "params",
        "chat",
        "error",
        "result"
      ]
    }
  ],
  "outputs": [
    {
      "name": "append",
      "node": "result",
      "port": "value"
    }
  ]
}
