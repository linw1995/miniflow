{
  "version": "2026-10-23",
  "dependencies": {
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "nodes": [
    {
      "id": "chat",
      "kind": "builtin.llm",
      "config": {
        "model": "your-model",
        "api_key_env": "MODEL_API_KEY"
      }
    }
  ],
  "outputs": [
    {
      "name": "text",
      "node": "chat",
      "port": "text"
    },
    {
      "name": "message",
      "node": "chat",
      "port": "message",
      "optional": true
    }
  ],
  "clusters": [
    {
      "label": "Model response",
      "annotation": "Send an explicit message list and return only the current assistant response.",
      "nodes": [
        "chat"
      ]
    }
  ]
}
