{
  "version": "2026-11-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    },
    "llm": {
      "package": "mfn-llm",
      "path": "../crates/builtin-nodes/llm"
    }
  },
  "flows": {
    "agent": {
      "builtin": "mfn-llm.agent"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "llm_model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "llm_base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "llm_api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY"
          },
          "deepseek_base_url": {
            "type": "string",
            "env": "DEEPSEEK_BASE_URL",
            "default": "https://api.deepseek.com",
            "secret": false
          },
          "deepseek_api_key": {
            "type": "string",
            "env": "DEEPSEEK_API_KEY"
          }
        }
      }
    },
    {
      "id": "search",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-deepseek/search.json"
        },
        "inputs": {
          "api_key": {
            "$ref": "params.deepseek_api_key"
          },
          "base_url": {
            "$ref": "params.deepseek_base_url"
          }
        }
      }
    },
    {
      "id": "fetch",
      "kind": "builtin.constant",
      "config": {
        "type": "flow",
        "value": {
          "path": "agent-deepseek/fetch.json"
        },
        "inputs": {
          "api_key": {
            "$ref": "params.deepseek_api_key"
          },
          "base_url": {
            "$ref": "params.deepseek_base_url"
          }
        }
      }
    },
    {
      "id": "tool_properties",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "search_interface": "object",
          "fetch_interface": "object"
        },
        "code": {
          "value": "{\n  'search': {\n    'description': 'Search the web using DeepSeek. Use a nonblank query of 1-128 Unicode characters and an optional count of 1-50 results (default 5). Returns titles, URLs, snippets, and summaries. Independent queries can run in parallel.',\n    'interface': search_interface\n  },\n  'fetch': {\n    'description': 'Fetch a web page at an absolute HTTP or HTTPS URL without embedded credentials. Returns the page title and Markdown. Use this after search to read a promising result and cite the source URL.',\n    'interface': fetch_interface\n  }\n}"
        }
      },
      "inputs": {
        "search_interface": {
          "$ref": "search.properties"
        },
        "fetch_interface": {
          "$ref": "fetch.properties"
        }
      }
    },
    {
      "id": "tools",
      "kind": "builtin.object",
      "config": {
        "fields": {
          "search": "flow",
          "fetch": "flow"
        }
      },
      "inputs": {
        "search": {
          "$ref": "search.value"
        },
        "fetch": {
          "$ref": "fetch.value"
        }
      }
    },
    {
      "id": "agent",
      "kind": "workflow.call",
      "config": {
        "flow": "agent"
      },
      "inputs": {
        "params.tools": {
          "$ref": "tools.value"
        },
        "params.tool_properties": {
          "$ref": "tool_properties.value"
        },
        "params.messages": {
          "$ref": "params.messages"
        },
        "params.model": {
          "$ref": "params.llm_model"
        },
        "params.base_url": {
          "$ref": "params.llm_base_url"
        },
        "params.api_key": {
          "$ref": "params.llm_api_key"
        }
      }
    },
    {
      "id": "result",
      "kind": "builtin.object",
      "config": {
        "fields": {
          "status": "string",
          "messages": {
            "list": "object"
          },
          "usages": {
            "list": "object"
          },
          "error": "string"
        }
      },
      "inputs": {
        "status": {
          "$ref": "agent.status"
        },
        "messages": {
          "$ref": "agent.messages"
        },
        "usages": {
          "$ref": "agent.usages"
        },
        "error": {
          "$ref": "agent.error"
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "params",
      "to_node": "search"
    },
    {
      "from_node": "params",
      "to_node": "fetch"
    }
  ],
  "outputs": [
    {
      "name": "tool_call_delta",
      "node": "agent",
      "port": "tool_call_delta",
      "optional": true
    },
    {
      "name": "answer",
      "node": "agent",
      "port": "answer",
      "optional": true
    },
    {
      "name": "append",
      "node": "result",
      "port": "value"
    }
  ]
}
