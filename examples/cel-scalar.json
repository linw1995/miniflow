{
  "version": "2026-09-26",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "source",
      "kind": "builtin.constant",
      "config": { "value": "21" }
    },
    {
      "id": "transform",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": { "amount": "string" },
        "code": { "doubled": "int(amount) * 2" }
      }
    }
  ],
  "edges": [
    {
      "from_node": "source",
      "from_output": "value",
      "to_node": "transform",
      "to_input": "amount"
    }
  ],
  "outputs": [
    { "name": "doubled", "node": "transform", "port": "doubled" }
  ]
}
