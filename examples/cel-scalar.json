{
  "version": "2026-10-23",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "path": "../crates/builtin-nodes/core"
    },
    "code": {
      "package": "mfn-code",
      "path": "../crates/builtin-nodes/code"
    }
  },
  "nodes": [
    {
      "id": "source",
      "kind": "builtin.constant",
      "config": { "value": "21" }
    },
    {
      "id": "transform",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": { "amount": "string" },
        "code": { "doubled": "int(amount) * 2" }
      },
      "inputs": {
        "amount": { "from": { "node": "source", "port": "value" } }
      }
    }
  ],
  "outputs": [
    { "name": "doubled", "node": "transform", "port": "doubled" }
  ],
  "clusters": [
    {
      "label": "Scalar computation",
      "annotation": "Parse the constant text as an integer and double it with CEL.",
      "nodes": ["source", "transform"]
    }
  ]
}
