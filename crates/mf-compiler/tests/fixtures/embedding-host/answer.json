{
  "version": "2026-10-03",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "version": "0.1.0"
    }
  },
  "nodes": [
    {
      "id": "source",
      "kind": "builtin.constant",
      "config": {
        "value": 42
      }
    },
    {
      "id": "echo",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "$ref": "source.value"
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "answer",
      "node": "echo",
      "port": "value"
    }
  ]
}
