  "clusters": [
    {
      "label": "Validate and combine inputs",
      "annotation": "Reject negative token settings and forward messages without copying when append_messages is empty.",
      "collapsed": true,
      "nodes": [
        "params",
        "settings_valid",
        "assert_settings",
        "append_route",
        "messages_only",
        "append_messages",
        "combined_messages"
      ]
    },
    {
      "label": "Gate and measure context",
      "annotation": "Short-circuit when disabled, locate prior compaction boundaries, and check token usage against the compaction threshold.",
