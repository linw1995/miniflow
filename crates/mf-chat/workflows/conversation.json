{
  "version": "2026-10-25",
  "dependencies": {
    "chat": {
      "package": "mf-chat",
      "version": "0.1.0"
    }
  },
  "nodes": [
    {
      "id": "begin",
      "kind": "mf_chat.turn.begin"
    },
    {
      "id": "workflow",
      "kind": "mf_chat.workflow.invoke",
      "inputs": {
        "database_path": {
          "from": {
            "node": "begin",
            "port": "database_path"
          }
        },
        "invocation": {
          "from": {
            "node": "begin",
            "port": "invocation"
          }
        },
        "request": {
          "from": {
            "node": "begin",
            "port": "request"
          }
        }
      }
    },
    {
      "id": "route",
      "kind": "mf_chat.conversation.route",
      "inputs": {
        "event": {
          "from": {
            "node": "workflow",
            "port": "event"
          }
        }
      }
    },
    {
      "id": "title_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "route.title_enabled",
                "path": ""
              },
              "operator": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "title",
      "kind": "workflow.call",
      "config": {
        "flow": "title"
      },
      "inputs": {
        "input.prompt": {
          "from": {
            "node": "route",
            "port": "title_prompt"
          }
        },
        "input.text": {
          "from": {
            "node": "route",
            "port": "title_text"
          }
        },
        "input.status": {
          "from": {
            "node": "route",
            "port": "title_status"
          }
        },
        "input.context": {
          "from": {
            "node": "route",
            "port": "title_context"
          }
        },
        "input.model": {
          "from": {
            "node": "route",
            "port": "title_model"
          }
        },
        "input.base_url": {
          "from": {
            "node": "route",
            "port": "title_base_url"
          }
        },
        "input.api_key": {
          "from": {
            "node": "route",
            "port": "title_api_key"
          }
        }
      }
    },
    {
      "id": "title_available",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "title.title",
                "path": ""
              },
              "operator": "exists"
            }
          }
        ]
      }
    },
    {
      "id": "selected_title",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "title",
            "port": "title"
          }
        }
      }
    },
    {
      "id": "missing_title",
      "kind": "builtin.constant",
      "config": {
        "value": null
      }
    },
    {
      "id": "no_title",
      "kind": "builtin.constant",
      "config": {
        "value": null
      }
    },
    {
      "id": "no_title_usages",
      "kind": "builtin.constant",
      "config": {
        "value": []
      }
    },
    {
      "id": "complete",
      "kind": "mf_chat.conversation.complete",
      "inputs": {
        "response": {
          "from": {
            "node": "route",
            "port": "response"
          }
        },
        "title": {
          "exclusive": [
            {
              "node": "selected_title",
              "port": "value"
            },
            {
              "node": "missing_title",
              "port": "value"
            },
            {
              "node": "no_title",
              "port": "value"
            }
          ]
        },
        "title_usages": {
          "exclusive": [
            {
              "node": "title",
              "port": "usages"
            },
            {
              "node": "no_title_usages",
              "port": "value"
            }
          ]
        }
      }
    },
    {
      "id": "settle",
      "kind": "mf_chat.turn.settle",
      "inputs": {
        "database_path": {
          "from": {
            "node": "route",
            "port": "database_path"
          }
        },
        "invocation": {
          "from": {
            "node": "route",
            "port": "invocation"
          }
        },
        "response": {
          "from": {
            "node": "complete",
            "port": "response"
          }
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "preview",
      "node": "route",
      "port": "preview",
      "optional": true
    },
    {
      "name": "settlement",
      "node": "settle",
      "port": "settlement",
      "optional": true
    }
  ],
  "flows": {
    "title": {
      "builtin": "mf-chat.chat-title"
    }
  },
  "edges": [
    {
      "from_node": "route",
      "from_output": "title_enabled",
      "to_node": "title_route"
    },
    {
      "from_node": "title_route",
      "from_output": "yes",
      "to_node": "title"
    },
    {
      "from_node": "title_route",
      "from_output": "else",
      "to_node": "no_title"
    },
    {
      "from_node": "title",
      "to_node": "title_available"
    },
    {
      "from_node": "title_available",
      "from_output": "else",
      "to_node": "missing_title"
    },
    {
      "from_node": "title_route",
      "from_output": "else",
      "to_node": "no_title_usages"
    },
    {
      "from_node": "title_available",
      "from_output": "yes",
      "to_node": "selected_title"
    }
  ]
}
