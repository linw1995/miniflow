{
  "version": "2026-10-19",
  "dependencies": {
    "chat": {
      "package": "mf-chat",
      "version": "0.1.0"
    }
  },
  "nodes": [
    {
      "id": "begin",
      "kind": "mf_chat.turn.begin"
    },
    {
      "id": "workflow",
      "kind": "mf_chat.workflow.invoke",
      "inputs": {
        "database_path": {
          "from": {
            "node": "begin",
            "port": "database_path"
          }
        },
        "invocation": {
          "from": {
            "node": "begin",
            "port": "invocation"
          }
        },
        "request": {
          "from": {
            "node": "begin",
            "port": "request"
          }
        }
      }
    },
    {
      "id": "route",
      "kind": "mf_chat.conversation.route",
      "inputs": {
        "event": {
          "from": {
            "node": "workflow",
            "port": "event"
          }
        }
      }
    },
    {
      "id": "settle",
      "kind": "mf_chat.turn.settle",
      "inputs": {
        "database_path": {
          "from": {
            "node": "route",
            "port": "database_path"
          }
        },
        "invocation": {
          "from": {
            "node": "route",
            "port": "invocation"
          }
        },
        "response": {
          "from": {
            "node": "route",
            "port": "response"
          }
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "preview",
      "node": "route",
      "port": "preview",
      "optional": true
    },
    {
      "name": "settlement",
      "node": "settle",
      "port": "settlement",
      "optional": true
    }
  ]
}
