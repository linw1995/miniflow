{
  "version": "2026-11-28",
  "execution": {},
  "dependencies": {
    "chat": {
      "package": "mf-chat",
      "version": "0.1.0"
    }
  },
  "nodes": [
    {
      "id": "begin",
      "kind": "workflow.call",
      "config": {
        "flow": "mf-chat.begin",
        "body": {
          "nodes": []
        }
      }
    },
    {
      "id": "workflow",
      "kind": "workflow.call",
      "config": {
        "flow": "mf-chat.workflow",
        "body": {
          "nodes": []
        }
      },
      "inputs": {
        "params.database_path": {
          "$ref": "begin.database_path"
        },
        "params.invocation": {
          "$ref": "begin.invocation"
        },
        "params.request": {
          "$ref": "begin.request"
        }
      }
    },
    {
      "id": "prepare_title",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "facts": "object"
        },
        "code": {
          "enabled": "facts.title_configured && facts.status == 'succeeded' && !facts.has_title && !('title' in facts.purposes)",
          "status": "string(facts.status)"
        }
      },
      "inputs": {
        "facts": {
          "$ref": "workflow.auxiliary"
        }
      }
    },
    {
      "id": "title_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "prepare_title.enabled",
                "path": ""
              },
              "operator": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "title",
      "kind": "workflow.call",
      "config": {
        "flow": "title"
      },
      "inputs": {
        "params.prompt": {
          "$ref": "workflow.title_prompt"
        },
        "params.text": {
          "$ref": "workflow.title_text"
        },
        "params.status": {
          "$ref": "prepare_title.status"
        },
        "params.context": {
          "$ref": "workflow.title_context"
        },
        "params.model": {
          "$ref": "workflow.title_model"
        },
        "params.base_url": {
          "$ref": "workflow.title_base_url"
        },
        "params.api_key": {
          "$ref": "workflow.title_api_key"
        }
      }
    },
    {
      "id": "title_available",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "title.title",
                "path": ""
              },
              "operator": "exists"
            }
          }
        ]
      }
    },
    {
      "id": "selected_title",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "$ref": "title.title"
        }
      }
    },
    {
      "id": "missing_title",
      "kind": "builtin.constant",
      "config": {
        "value": null
      }
    },
    {
      "id": "no_title",
      "kind": "builtin.constant",
      "config": {
        "value": null
      }
    },
    {
      "id": "no_title_usages",
      "kind": "builtin.constant",
      "config": {
        "value": []
      }
    },
    {
      "id": "resolved_title_usages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "title.usages"
            },
            {
              "$ref": "no_title_usages.value"
            }
          ]
        }
      }
    },
    {
      "id": "compact_gate",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "facts": "object"
        },
        "code": {
          "enabled": "facts.compaction_configured && facts.status == 'succeeded' && facts.appends_context && !('compaction' in facts.purposes)"
        }
      },
      "inputs": {
        "facts": {
          "$ref": "workflow.auxiliary"
        }
      }
    },
    {
      "id": "compact_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "compact_gate.enabled",
                "path": ""
              },
              "operator": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "compact",
      "kind": "workflow.call",
      "config": {
        "flow": "compact"
      },
      "inputs": {
        "params.messages": {
          "$ref": "workflow.compact_messages"
        },
        "params.append_messages": {
          "$ref": "workflow.compact_append_messages"
        },
        "params.usages": {
          "$ref": "workflow.compact_usages"
        },
        "params.context": {
          "$ref": "workflow.compact_context"
        },
        "params.model": {
          "$ref": "workflow.compact_model"
        },
        "params.base_url": {
          "$ref": "workflow.compact_base_url"
        },
        "params.api_key": {
          "$ref": "workflow.compact_api_key"
        }
      }
    },
    {
      "id": "compact_applied",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "compact.compacted",
                "path": ""
              },
              "operator": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "compacted_messages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "$ref": "compact.messages"
        }
      }
    },
    {
      "id": "unchanged_context",
      "kind": "builtin.constant",
      "config": {
        "value": null
      }
    },
    {
      "id": "no_compact_messages",
      "kind": "builtin.constant",
      "config": {
        "value": null
      }
    },
    {
      "id": "no_compact_usages",
      "kind": "builtin.constant",
      "config": {
        "value": []
      }
    },
    {
      "id": "finish",
      "kind": "workflow.call",
      "config": {
        "flow": "mf-chat.finish",
        "body": {
          "nodes": []
        }
      },
      "inputs": {
        "params.title": {
          "exclusive": [
            {
              "$ref": "selected_title.value"
            },
            {
              "$ref": "missing_title.value"
            },
            {
              "$ref": "no_title.value"
            }
          ]
        },
        "params.title_usages": {
          "$ref": "resolved_title_usages.value"
        },
        "params.compacted_messages": {
          "exclusive": [
            {
              "$ref": "compacted_messages.value"
            },
            {
              "$ref": "unchanged_context.value"
            },
            {
              "$ref": "no_compact_messages.value"
            }
          ]
        },
        "params.compaction_usages": {
          "exclusive": [
            {
              "$ref": "compact.usages"
            },
            {
              "$ref": "no_compact_usages.value"
            }
          ]
        },
        "params.completed": {
          "$ref": "workflow.completed"
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "preview",
      "node": "workflow",
      "port": "preview",
      "optional": true
    },
    {
      "name": "settlement",
      "node": "finish",
      "port": "settlement"
    }
  ],
  "flows": {
    "title": {
      "builtin": "mf-chat.chat-title"
    },
    "compact": {
      "builtin": "mf-chat.chat-compact"
    }
  },
  "edges": [
    {
      "from_node": "prepare_title",
      "to_node": "title_route"
    },
    {
      "from_node": "title_route",
      "from_output": "yes",
      "to_node": "title"
    },
    {
      "from_node": "title_route",
      "from_output": "else",
      "to_node": "no_title"
    },
    {
      "from_node": "title",
      "to_node": "title_available"
    },
    {
      "from_node": "title_available",
      "from_output": "else",
      "to_node": "missing_title"
    },
    {
      "from_node": "title_route",
      "from_output": "else",
      "to_node": "no_title_usages"
    },
    {
      "from_node": "title_available",
      "from_output": "yes",
      "to_node": "selected_title"
    },
    {
      "from_node": "resolved_title_usages",
      "to_node": "compact_gate"
    },
    {
      "from_node": "compact_gate",
      "to_node": "compact_route"
    },
    {
      "from_node": "compact_route",
      "from_output": "yes",
      "to_node": "compact"
    },
    {
      "from_node": "compact_route",
      "from_output": "else",
      "to_node": "no_compact_messages"
    },
    {
      "from_node": "compact_route",
      "from_output": "else",
      "to_node": "no_compact_usages"
    },
    {
      "from_node": "compact",
      "to_node": "compact_applied"
    },
    {
      "from_node": "compact_applied",
      "from_output": "yes",
      "to_node": "compacted_messages"
    },
    {
      "from_node": "compact_applied",
      "from_output": "else",
      "to_node": "unchanged_context"
    }
  ]
}
