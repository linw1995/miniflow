{
  "version": "2026-10-28",
  "dependencies": {
    "chat": {
      "package": "mf-chat",
      "version": "0.1.0"
    }
  },
  "nodes": [
    {
      "id": "begin",
      "kind": "mf_chat.turn.begin"
    },
    {
      "id": "workflow",
      "kind": "mf_chat.workflow.invoke",
      "inputs": {
        "database_path": {
          "from": {
            "node": "begin",
            "port": "database_path"
          }
        },
        "invocation": {
          "from": {
            "node": "begin",
            "port": "invocation"
          }
        },
        "request": {
          "from": {
            "node": "begin",
            "port": "request"
          }
        }
      }
    },
    {
      "id": "route",
      "kind": "mf_chat.conversation.route",
      "inputs": {
        "event": {
          "from": {
            "node": "workflow",
            "port": "event"
          }
        }
      }
    },
    {
      "id": "prepare_title",
      "kind": "mf_chat.title.prepare",
      "inputs": {
        "completed": {
          "from": {
            "node": "route",
            "port": "completed"
          }
        }
      }
    },
    {
      "id": "title_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "prepare_title.enabled",
                "path": ""
              },
              "operator": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "title",
      "kind": "workflow.call",
      "config": {
        "flow": "title"
      },
      "inputs": {
        "params.prompt": {
          "from": {
            "node": "prepare_title",
            "port": "prompt"
          }
        },
        "params.text": {
          "from": {
            "node": "prepare_title",
            "port": "text"
          }
        },
        "params.status": {
          "from": {
            "node": "prepare_title",
            "port": "status"
          }
        },
        "params.context": {
          "from": {
            "node": "prepare_title",
            "port": "context"
          }
        },
        "params.model": {
          "from": {
            "node": "prepare_title",
            "port": "model"
          }
        },
        "params.base_url": {
          "from": {
            "node": "prepare_title",
            "port": "base_url"
          }
        },
        "params.api_key": {
          "from": {
            "node": "prepare_title",
            "port": "api_key"
          }
        }
      }
    },
    {
      "id": "title_available",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "title.title",
                "path": ""
              },
              "operator": "exists"
            }
          }
        ]
      }
    },
    {
      "id": "selected_title",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "title",
            "port": "title"
          }
        }
      }
    },
    {
      "id": "missing_title",
      "kind": "builtin.constant",
      "config": {
        "value": null
      }
    },
    {
      "id": "no_title",
      "kind": "builtin.constant",
      "config": {
        "value": null
      }
    },
    {
      "id": "no_title_usages",
      "kind": "builtin.constant",
      "config": {
        "value": []
      }
    },
    {
      "id": "finish",
      "kind": "mf_chat.conversation.finish",
      "inputs": {
        "title": {
          "exclusive": [
            {
              "node": "selected_title",
              "port": "value"
            },
            {
              "node": "missing_title",
              "port": "value"
            },
            {
              "node": "no_title",
              "port": "value"
            }
          ]
        },
        "title_usages": {
          "exclusive": [
            {
              "node": "title",
              "port": "usages"
            },
            {
              "node": "no_title_usages",
              "port": "value"
            }
          ]
        },
        "completed": {
          "from": {
            "node": "route",
            "port": "completed"
          }
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "preview",
      "node": "route",
      "port": "preview",
      "optional": true
    },
    {
      "name": "settlement",
      "node": "finish",
      "port": "settlement",
      "optional": true
    }
  ],
  "flows": {
    "title": {
      "builtin": "mf-chat.chat-title"
    }
  },
  "edges": [
    {
      "from_node": "prepare_title",
      "to_node": "title_route"
    },
    {
      "from_node": "title_route",
      "from_output": "yes",
      "to_node": "title"
    },
    {
      "from_node": "title_route",
      "from_output": "else",
      "to_node": "no_title"
    },
    {
      "from_node": "title",
      "to_node": "title_available"
    },
    {
      "from_node": "title_available",
      "from_output": "else",
      "to_node": "missing_title"
    },
    {
      "from_node": "title_route",
      "from_output": "else",
      "to_node": "no_title_usages"
    },
    {
      "from_node": "title_available",
      "from_output": "yes",
      "to_node": "selected_title"
    }
  ]
}
