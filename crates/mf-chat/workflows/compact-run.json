{
  "version": "2026-11-28",
  "dependencies": {
    "core": {
      "package": "mfn-core"
    },
    "code": {
      "package": "mfn-code"
    }
  },
  "flows": {
    "plan": {
      "builtin": "mf-chat.chat-compact-plan"
    },
    "summarize": {
      "builtin": "mf-chat.chat-compact-summarize"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "state": {
            "type": "object",
            "secret": false
          },
          "tokens_before": {
            "type": "int",
            "secret": false
          },
          "keep_recent_tokens": {
            "type": "int",
            "default": 20000,
            "secret": false
          },
          "custom_instructions": {
            "type": "string",
            "default": "",
            "secret": false
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY"
          }
        }
      }
    },
    {
      "id": "plan",
      "kind": "workflow.call",
      "config": {
        "flow": "plan"
      },
      "inputs": {
        "params.messages": {
          "$ref": "params.messages"
        },
        "params.state": {
          "$ref": "params.state"
        },
        "params.keep_recent_tokens": {
          "$ref": "params.keep_recent_tokens"
        },
        "params.custom_instructions": {
          "$ref": "params.custom_instructions"
        }
      }
    },
    {
      "id": "compact_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "compact",
            "condition": {
              "source": {
                "output": "plan.should_compact",
                "path": ""
              },
              "operator": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "nothing_messages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "$ref": "params.messages"
        }
      }
    },
    {
      "id": "nothing_result",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {},
        "code": {
          "status": "'skipped'",
          "compacted": "false",
          "summary": "''",
          "error": "''",
          "read_files": "[].map(x, string(x))",
          "modified_files": "[].map(x, string(x))"
        }
      }
    },
    {
      "id": "nothing_usages",
      "kind": "builtin.constant",
      "config": {
        "value": []
      }
    },
    {
      "id": "history_error_prefix",
      "kind": "builtin.constant",
      "config": {
        "value": "Summarization"
      }
    },
    {
      "id": "turn_prefix_error_prefix",
      "kind": "builtin.constant",
      "config": {
        "value": "Turn prefix summarization"
      }
    },
    {
      "id": "summarize_history",
      "kind": "workflow.call",
      "config": {
        "flow": "summarize"
      },
      "inputs": {
        "params.enabled": {
          "$ref": "plan.has_history"
        },
        "params.messages": {
          "$ref": "plan.history_request"
        },
        "params.error_prefix": {
          "$ref": "history_error_prefix.value"
        },
        "params.model": {
          "$ref": "params.model"
        },
        "params.base_url": {
          "$ref": "params.base_url"
        },
        "params.api_key": {
          "$ref": "params.api_key"
        }
      }
    },
    {
      "id": "turn_prefix_eligible",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "history_ok": "bool",
          "has_turn_prefix": "bool"
        },
        "code": {
          "run": "history_ok && has_turn_prefix"
        }
      },
      "inputs": {
        "history_ok": {
          "$ref": "summarize_history.ok"
        },
        "has_turn_prefix": {
          "$ref": "plan.has_turn_prefix"
        }
      }
    },
    {
      "id": "summarize_turn_prefix",
      "kind": "workflow.call",
      "config": {
        "flow": "summarize"
      },
      "inputs": {
        "params.enabled": {
          "$ref": "turn_prefix_eligible.run"
        },
        "params.messages": {
          "$ref": "plan.turn_prefix_request"
        },
        "params.error_prefix": {
          "$ref": "turn_prefix_error_prefix.value"
        },
        "params.model": {
          "$ref": "params.model"
        },
        "params.base_url": {
          "$ref": "params.base_url"
        },
        "params.api_key": {
          "$ref": "params.api_key"
        }
      }
    },
    {
      "id": "summarize_status",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "history_ok": "bool",
          "turn_prefix_ok": "bool",
          "history_error": "string",
          "turn_prefix_error": "string",
          "history_usages": {
            "list": "object"
          },
          "turn_prefix_usages": {
            "list": "object"
          }
        },
        "code": {
          "ok": "history_ok && turn_prefix_ok",
          "error": "history_error != '' ? history_error : turn_prefix_error",
          "usages": "history_usages + turn_prefix_usages"
        }
      },
      "inputs": {
        "history_ok": {
          "$ref": "summarize_history.ok"
        },
        "turn_prefix_ok": {
          "$ref": "summarize_turn_prefix.ok"
        },
        "history_error": {
          "$ref": "summarize_history.error"
        },
        "turn_prefix_error": {
          "$ref": "summarize_turn_prefix.error"
        },
        "history_usages": {
          "$ref": "summarize_history.usages"
        },
        "turn_prefix_usages": {
          "$ref": "summarize_turn_prefix.usages"
        }
      }
    },
    {
      "id": "assemble_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "yes",
            "condition": {
              "source": {
                "output": "summarize_status.ok",
                "path": ""
              },
              "operator": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "compose_body",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "is_split_turn": "bool",
          "has_history": "bool",
          "has_turn_prefix": "bool",
          "previous_summary": "string",
          "history_summary": "string",
          "turn_prefix_summary": "string"
        },
        "code": {
          "body": "is_split_turn && has_turn_prefix ? (has_history ? history_summary.trim() : (previous_summary.trim() != '' ? previous_summary.trim() : 'No prior history.')) + '\\n\\n---\\n\\n**Turn Context (split turn):**\\n\\n' + turn_prefix_summary.trim() : history_summary.trim()"
        }
      },
      "inputs": {
        "is_split_turn": {
          "$ref": "plan.is_split_turn"
        },
        "has_history": {
          "$ref": "plan.has_history"
        },
        "has_turn_prefix": {
          "$ref": "plan.has_turn_prefix"
        },
        "previous_summary": {
          "$ref": "plan.previous_summary"
        },
        "history_summary": {
          "$ref": "summarize_history.text"
        },
        "turn_prefix_summary": {
          "$ref": "summarize_turn_prefix.text"
        }
      }
    },
    {
      "id": "compose_summary",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "body": "string",
          "read_files": {
            "list": "string"
          },
          "modified_files": {
            "list": "string"
          }
        },
        "code": {
          "summary": "cel.bind(sections, (size(read_files) > 0 ? ['<read-files>\\n' + read_files.join('\\n') + '\\n</read-files>'] : []) + (size(modified_files) > 0 ? ['<modified-files>\\n' + modified_files.join('\\n') + '\\n</modified-files>'] : []), body + (size(sections) > 0 ? '\\n\\n' + sections.map(s, string(s)).join('\\n\\n') : ''))"
        }
      },
      "inputs": {
        "body": {
          "$ref": "compose_body.body"
        },
        "read_files": {
          "$ref": "plan.read_files"
        },
        "modified_files": {
          "$ref": "plan.modified_files"
        }
      }
    },
    {
      "id": "compose_messages",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "system_messages": {
            "list": "object"
          },
          "kept_messages": {
            "list": "object"
          },
          "body": "string",
          "summary": "string",
          "read_files": {
            "list": "string"
          },
          "modified_files": {
            "list": "string"
          },
          "tokens_before": "int"
        },
        "code": {
          "messages": "system_messages + [{'role': 'user', 'content': 'The conversation history before this point was compacted into the following summary:\\n\\n<summary>\\n' + summary + '\\n</summary>', 'metadata': {'compaction': {'summary': body, 'read_files': read_files, 'modified_files': modified_files, 'tokens_before': tokens_before}}}] + kept_messages",
          "read_files": "read_files",
          "modified_files": "modified_files"
        }
      },
      "inputs": {
        "system_messages": {
          "$ref": "plan.system_messages"
        },
        "kept_messages": {
          "$ref": "plan.kept_messages"
        },
        "body": {
          "$ref": "compose_body.body"
        },
        "summary": {
          "$ref": "compose_summary.summary"
        },
        "read_files": {
          "$ref": "plan.read_files"
        },
        "modified_files": {
          "$ref": "plan.modified_files"
        },
        "tokens_before": {
          "$ref": "params.tokens_before"
        }
      }
    },
    {
      "id": "succeeded_meta",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {},
        "code": {
          "status": "'succeeded'",
          "compacted": "true",
          "error": "''"
        }
      }
    },
    {
      "id": "failed_messages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "$ref": "params.messages"
        }
      }
    },
    {
      "id": "failed_result",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "error": "string"
        },
        "code": {
          "status": "'failed'",
          "compacted": "false",
          "summary": "''",
          "error": "error",
          "read_files": "[].map(x, string(x))",
          "modified_files": "[].map(x, string(x))"
        }
      },
      "inputs": {
        "error": {
          "$ref": "summarize_status.error"
        }
      }
    },
    {
      "id": "status",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "nothing_result.status"
            },
            {
              "$ref": "succeeded_meta.status"
            },
            {
              "$ref": "failed_result.status"
            }
          ]
        }
      }
    },
    {
      "id": "compacted",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "nothing_result.compacted"
            },
            {
              "$ref": "succeeded_meta.compacted"
            },
            {
              "$ref": "failed_result.compacted"
            }
          ]
        }
      }
    },
    {
      "id": "messages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "nothing_messages.value"
            },
            {
              "$ref": "compose_messages.messages"
            },
            {
              "$ref": "failed_messages.value"
            }
          ]
        }
      }
    },
    {
      "id": "summary",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "nothing_result.summary"
            },
            {
              "$ref": "compose_summary.summary"
            },
            {
              "$ref": "failed_result.summary"
            }
          ]
        }
      }
    },
    {
      "id": "usages",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "nothing_usages.value"
            },
            {
              "$ref": "summarize_status.usages"
            }
          ]
        }
      }
    },
    {
      "id": "read_files",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "nothing_result.read_files"
            },
            {
              "$ref": "compose_messages.read_files"
            },
            {
              "$ref": "failed_result.read_files"
            }
          ]
        }
      }
    },
    {
      "id": "modified_files",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "nothing_result.modified_files"
            },
            {
              "$ref": "compose_messages.modified_files"
            },
            {
              "$ref": "failed_result.modified_files"
            }
          ]
        }
      }
    },
    {
      "id": "error",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "nothing_result.error"
            },
            {
              "$ref": "succeeded_meta.error"
            },
            {
              "$ref": "failed_result.error"
            }
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "plan",
      "to_node": "compact_route"
    },
    {
      "from_node": "compact_route",
      "from_output": "else",
      "to_node": "nothing_messages"
    },
    {
      "from_node": "compact_route",
      "from_output": "else",
      "to_node": "nothing_result"
    },
    {
      "from_node": "compact_route",
      "from_output": "else",
      "to_node": "nothing_usages"
    },
    {
      "from_node": "compact_route",
      "from_output": "compact",
      "to_node": "summarize_history"
    },
    {
      "from_node": "summarize_status",
      "to_node": "assemble_route"
    },
    {
      "from_node": "assemble_route",
      "from_output": "yes",
      "to_node": "compose_body"
    },
    {
      "from_node": "assemble_route",
      "from_output": "yes",
      "to_node": "succeeded_meta"
    },
    {
      "from_node": "assemble_route",
      "from_output": "else",
      "to_node": "failed_messages"
    },
    {
      "from_node": "assemble_route",
      "from_output": "else",
      "to_node": "failed_result"
    }
  ],
  "outputs": [
    {
      "name": "status",
      "node": "status",
      "port": "value"
    },
    {
      "name": "compacted",
      "node": "compacted",
      "port": "value"
    },
    {
      "name": "messages",
      "node": "messages",
      "port": "value"
    },
    {
      "name": "summary",
      "node": "summary",
      "port": "value"
    },
    {
      "name": "usages",
      "node": "usages",
      "port": "value"
    },
    {
      "name": "read_files",
      "node": "read_files",
      "port": "value"
    },
    {
      "name": "modified_files",
      "node": "modified_files",
      "port": "value"
    },
    {
      "name": "error",
      "node": "error",
      "port": "value"
    }
  ],
  "clusters": [
    {
      "label": "Plan compaction",
      "annotation": "Select the cut point, extract cumulative files, and skip cleanly when nothing lies before the cut.",
      "nodes": [
        "params",
        "plan",
        "compact_route",
        "nothing_messages",
        "nothing_result",
        "nothing_usages"
      ]
    },
    {
      "label": "Summarize",
      "annotation": "Summarize complete prior history and any split-turn prefix through the shared summarization Flow.",
      "nodes": [
        "history_error_prefix",
        "turn_prefix_error_prefix",
        "summarize_history",
        "turn_prefix_eligible",
        "summarize_turn_prefix",
        "summarize_status"
      ]
    },
    {
      "label": "Assemble result",
      "annotation": "Compose the compacted summary message and metadata on success, or preserve original messages on failure.",
      "nodes": [
        "assemble_route",
        "compose_body",
        "compose_summary",
        "compose_messages",
        "succeeded_meta",
        "failed_messages",
        "failed_result"
      ]
    },
    {
      "label": "Output contract",
      "annotation": "Merge skipped, succeeded, and failed branches into the stable compaction result ports.",
      "collapsed": true,
      "nodes": [
        "status",
        "compacted",
        "messages",
        "summary",
        "usages",
        "read_files",
        "modified_files",
        "error"
      ]
    }
  ]
}
