{
  "version": "2026-11-01",
  "annotation": "Adapt and dispatch a list of tool calls with native parallel Iteration.",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "version": "=0.1.0"
    },
    "code": {
      "package": "mfn-code",
      "version": "=0.1.0"
    },
    "llm": {
      "package": "mfn-llm",
      "version": "=0.1.0"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "calls": {
            "type": {
              "list": "object"
            },
            "secret": false
          }
        }
      }
    },
    {
      "id": "dispatch",
      "kind": "builtin.iteration",
      "config": {
        "mode": "parallel",
        "on_error": "terminate",
        "body": {
          "nodes": [
            {
              "id": "unknown",
              "kind": "builtin.constant",
              "config": {
                "value": {
                  "error": "unknown tool"
                }
              }
            },
            {
              "id": "result",
              "kind": "llm.tool_result",
              "inputs": {
                "call": {
                  "from": {
                    "node": "%iteration",
                    "port": "item"
                  }
                },
                "result": {
                  "from": {
                    "node": "unknown",
                    "port": "value"
                  }
                }
              }
            }
          ],
          "result": {
            "node": "result",
            "port": "result"
          }
        }
      },
      "inputs": {
        "items": {
          "from": {
            "node": "params",
            "port": "calls"
          }
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "results",
      "node": "dispatch",
      "port": "results"
    }
  ]
}
