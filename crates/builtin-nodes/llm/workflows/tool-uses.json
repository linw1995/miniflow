{
  "version": "2026-11-28",
  "dependencies": {
    "core": {
      "package": "mfn-core"
    },
    "code": {
      "package": "mfn-code"
    },
    "llm": {
      "package": "mfn-llm"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "model_call_id": {
            "type": "string",
            "default": "",
            "secret": false
          },
          "calls": {
            "type": {
              "list": "object"
            },
            "secret": false
          },
          "tools": {
            "type": {
              "map": "flow"
            },
            "secret": false
          },
          "tool_properties": {
            "type": {
              "map": "object"
            },
            "secret": false
          }
        }
      }
    },
    {
      "id": "calls_valid",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "calls": {
            "list": "object"
          }
        },
        "code": {
          "valid": "calls.all(c, size(c) == 3 && 'id' in c && type(c.id) == string && c.id.matches(r'\\S') && 'name' in c && type(c.name) == string && 'arguments' in c)"
        }
      },
      "inputs": {
        "calls": {
          "$ref": "params.calls"
        }
      }
    },
    {
      "id": "require_calls",
      "kind": "builtin.assert",
      "config": {
        "message": "Tool calls must contain exactly a nonblank string id, a string name, and arguments",
        "condition": {
          "source": {
            "output": "calls_valid.valid",
            "path": ""
          },
          "operator": "eq",
          "value": true
        }
      }
    },
    {
      "id": "validated_calls",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "$ref": "params.calls"
        }
      }
    },
    {
      "id": "dispatch",
      "kind": "builtin.iteration",
      "config": {
        "mode": "parallel",
        "on_error": "terminate",
        "stream_outputs": {
          "tool_output": {
            "node": "execute",
            "port": "update"
          }
        },
        "inputs": {
          "model_call_id": "string",
          "tools": {
            "map": "object"
          },
          "flows": {
            "map": "flow"
          }
        },
        "body": {
          "version": "2026-11-28",
          "nodes": [
            {
              "id": "classify",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "model_call_id": "string",
                  "call": "object",
                  "tools": "object"
                },
                "code": {
                  "stream_context": "{'model_call_id': model_call_id, 'tool_call_id': call.id, 'name': call.name}",
                  "name": "call.name",
                  "ok": "call.name in tools && type(call.arguments) == map && size(call.arguments) == size(call.arguments.transformMap(k, v, k in tools[call.name].interface.allowed, v)) && tools[call.name].interface.required.all(r, r in call.arguments)",
                  "arguments": "call.name in tools && type(call.arguments) == map ? call.arguments.transformMap(k, v, k in tools[call.name].interface.allowed, v) : {}",
                  "error": "cel.bind(missing, (call.name in tools ? tools[call.name].interface.required.filter(r, !(r in (type(call.arguments) == map ? call.arguments : {}))) : []), {'error': !(call.name in tools) ? 'unknown tool' : type(call.arguments) != map ? 'arguments must be a JSON object' : size(call.arguments) != size(call.arguments.transformMap(k, v, k in tools[call.name].interface.allowed, v)) ? 'unknown, secret, or configured argument' : size(missing) > 0 ? 'missing required argument `' + missing[0] + '`' : ''})",
                  "plain": "call.name in tools && tools[call.name].interface.plain"
                }
              },
              "inputs": {
                "model_call_id": {
                  "$ref": "%iteration.model_call_id"
                },
                "call": {
                  "$ref": "%iteration.item"
                },
                "tools": {
                  "$ref": "%iteration.tools"
                }
              }
            },
            {
              "id": "gate",
              "kind": "builtin.if_else",
              "config": {
                "branches": [
                  {
                    "id": "ok",
                    "condition": {
                      "source": {
                        "output": "classify.ok",
                        "path": ""
                      },
                      "operator": "eq",
                      "value": true
                    }
                  }
                ]
              }
            },
            {
              "id": "execute",
              "kind": "builtin.router",
              "config": {
                "routes": [],
                "forward_stream": "progress"
              },
              "inputs": {
                "stream_context": {
                  "$ref": "classify.stream_context"
                },
                "flows": {
                  "$ref": "%iteration.flows"
                },
                "route": {
                  "$ref": "classify.name"
                },
                "arguments": {
                  "$ref": "classify.arguments"
                }
              }
            },
            {
              "id": "fail",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "error": "object"
                },
                "code": {
                  "value": "error"
                }
              },
              "inputs": {
                "error": {
                  "$ref": "classify.error"
                }
              }
            },
            {
              "id": "encode",
              "kind": "llm.tool_result",
              "inputs": {
                "call": {
                  "$ref": "%iteration.item"
                },
                "plain_content": {
                  "$ref": "classify.plain"
                },
                "result": {
                  "exclusive": [
                    {
                      "$ref": "fail.value"
                    },
                    {
                      "$ref": "execute.result"
                    }
                  ]
                }
              }
            }
          ],
          "edges": [
            {
              "from_node": "classify",
              "to_node": "gate"
            },
            {
              "from_node": "gate",
              "from_output": "else",
              "to_node": "fail"
            },
            {
              "from_node": "gate",
              "from_output": "ok",
              "to_node": "execute"
            }
          ],
          "clusters": [
            {
              "label": "Check arguments",
              "annotation": "Select the tool and check its public arguments.",
              "collapsed": true,
              "nodes": [
                "classify",
                "gate"
              ]
            },
            {
              "label": "Encode result",
              "annotation": "Keep the call ID with the tool content or error.",
              "collapsed": true,
              "nodes": [
                "fail",
                "encode"
              ]
            }
          ],
          "outputs": [
            {
              "name": "result",
              "node": "encode",
              "port": "result"
            }
          ]
        }
      },
      "inputs": {
        "model_call_id": {
          "$ref": "params.model_call_id"
        },
        "items": {
          "$ref": "validated_calls.value"
        },
        "tools": {
          "$ref": "params.tool_properties"
        },
        "flows": {
          "$ref": "params.tools"
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "calls_valid",
      "to_node": "require_calls"
    },
    {
      "from_node": "require_calls",
      "to_node": "validated_calls"
    }
  ],
  "clusters": [
    {
      "label": "Validate calls",
      "annotation": "Reject malformed calls before starting the parallel batch.",
      "collapsed": true,
      "nodes": [
        "params",
        "calls_valid",
        "require_calls",
        "validated_calls"
      ]
    }
  ],
  "outputs": [
    {
      "name": "tool_output",
      "node": "dispatch",
      "port": "tool_output",
      "optional": true
    },
    {
      "name": "results",
      "node": "dispatch",
      "port": "results"
    }
  ]
}
