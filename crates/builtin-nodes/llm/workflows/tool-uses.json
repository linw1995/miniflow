{
  "version": "2026-10-28",
  "dependencies": {
    "core": {
      "package": "mfn-core",
      "version": "=0.1.0"
    },
    "code": {
      "package": "mfn-code",
      "version": "=0.1.0"
    },
    "llm": {
      "package": "mfn-llm",
      "version": "=0.1.0"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "calls": {
            "type": {
              "list": "object"
            },
            "secret": false
          }
        }
      }
    },
    {
      "id": "bindings",
      "kind": "llm.tool_set",
      "config": {
        "names": []
      }
    },
    {
      "id": "catalog",
      "kind": "builtin.iteration",
      "config": {
        "mode": "parallel",
        "on_error": "terminate",
        "body": {
          "nodes": [
            {
              "id": "definition",
              "kind": "llm.tool_definition",
              "inputs": {
                "binding": {
                  "from": {
                    "node": "%iteration",
                    "port": "item"
                  }
                }
              }
            }
          ],
          "outputs": [
            {
              "name": "result",
              "node": "definition",
              "port": "definition"
            }
          ]
        }
      },
      "inputs": {
        "items": {
          "from": {
            "node": "bindings",
            "port": "bindings"
          }
        }
      }
    },
    {
      "id": "items",
      "kind": "llm.tool_calls",
      "inputs": {
        "calls": {
          "from": {
            "node": "params",
            "port": "calls"
          }
        },
        "bindings": {
          "from": {
            "node": "bindings",
            "port": "bindings"
          }
        },
        "flows": {
          "from": {
            "node": "bindings",
            "port": "flows"
          }
        }
      }
    },
    {
      "id": "dispatch",
      "kind": "builtin.iteration",
      "config": {
        "mode": "parallel",
        "on_error": "terminate",
        "body": {
          "nodes": [
            {
              "id": "select",
              "kind": "llm.tool_call",
              "inputs": {
                "item": {
                  "from": {
                    "node": "%iteration",
                    "port": "item"
                  }
                }
              }
            },
            {
              "id": "route",
              "kind": "builtin.router",
              "config": {
                "routes": [
                  "known"
                ]
              },
              "inputs": {
                "route": {
                  "from": {
                    "node": "select",
                    "port": "route"
                  }
                }
              }
            },
            {
              "id": "arguments",
              "kind": "llm.tool_arguments",
              "inputs": {
                "call": {
                  "from": {
                    "node": "select",
                    "port": "call"
                  }
                },
                "binding": {
                  "from": {
                    "node": "select",
                    "port": "binding"
                  }
                }
              }
            },
            {
              "id": "execute",
              "kind": "builtin.router",
              "config": {
                "mode": "execute"
              },
              "inputs": {
                "route": {
                  "from": {
                    "node": "select",
                    "port": "name"
                  }
                },
                "flows": {
                  "from": {
                    "node": "select",
                    "port": "flows"
                  }
                },
                "arguments": {
                  "from": {
                    "node": "arguments",
                    "port": "arguments"
                  }
                }
              }
            },
            {
              "id": "encode",
              "kind": "llm.tool_result",
              "inputs": {
                "call": {
                  "from": {
                    "node": "select",
                    "port": "call"
                  }
                },
                "plain_content": {
                  "from": {
                    "node": "arguments",
                    "port": "plain_content"
                  }
                },
                "result": {
                  "exclusive": [
                    {
                      "node": "arguments",
                      "port": "error"
                    },
                    {
                      "node": "execute",
                      "port": "result"
                    }
                  ]
                }
              }
            },
            {
              "id": "unknown",
              "kind": "builtin.constant",
              "config": {
                "value": {
                  "error": "unknown tool"
                }
              }
            },
            {
              "id": "unknown_result",
              "kind": "llm.tool_result",
              "inputs": {
                "call": {
                  "from": {
                    "node": "select",
                    "port": "call"
                  }
                },
                "result": {
                  "from": {
                    "node": "unknown",
                    "port": "value"
                  }
                }
              }
            },
            {
              "id": "result",
              "kind": "builtin.identity",
              "inputs": {
                "input": {
                  "exclusive": [
                    {
                      "node": "encode",
                      "port": "result"
                    },
                    {
                      "node": "unknown_result",
                      "port": "result"
                    }
                  ]
                }
              }
            }
          ],
          "edges": [
            {
              "from_node": "route",
              "from_output": "known",
              "to_node": "arguments"
            },
            {
              "from_node": "route",
              "from_output": "else",
              "to_node": "unknown"
            }
          ],
          "outputs": [
            {
              "name": "result",
              "node": "result",
              "port": "value"
            }
          ]
        }
      },
      "inputs": {
        "items": {
          "from": {
            "node": "items",
            "port": "items"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "catalog",
      "from_output": "results",
      "to_node": "dispatch"
    }
  ],
  "outputs": [
    {
      "name": "catalog",
      "node": "catalog",
      "port": "results"
    },
    {
      "name": "results",
      "node": "dispatch",
      "port": "results"
    }
  ]
}
