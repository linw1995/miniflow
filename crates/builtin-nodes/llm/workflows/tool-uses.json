{
  "version": "2026-10-28",
  "dependencies": {
    "core": {
      "package": "mfn-core"
    },
    "code": {
      "package": "mfn-code"
    },
    "llm": {
      "package": "mfn-llm"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "origin": {
            "type": "object",
            "default": {},
            "secret": false
          },
          "calls": {
            "type": {
              "list": "object"
            },
            "secret": false
          },
          "tools": {
            "type": {
              "map": "flow"
            },
            "secret": false
          },
          "tool_properties": {
            "type": {
              "map": "object"
            },
            "secret": false
          }
        }
      }
    },
    {
      "id": "calls_valid",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "calls": {
            "list": "object"
          }
        },
        "code": {
          "valid": "calls.all(c, size(c) == 3 && 'id' in c && type(c.id) == string && c.id.matches(r'\\S') && 'name' in c && type(c.name) == string && 'arguments' in c)"
        }
      },
      "inputs": {
        "calls": {
          "from": {
            "node": "params",
            "port": "calls"
          }
        }
      }
    },
    {
      "id": "require_calls",
      "kind": "builtin.assert",
      "config": {
        "message": "Tool calls must contain exactly a nonblank string id, a string name, and arguments",
        "condition": {
          "source": {
            "output": "calls_valid.valid",
            "path": ""
          },
          "operator": "eq",
          "value": true
        }
      }
    },
    {
      "id": "validated_calls",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "params",
            "port": "calls"
          }
        }
      }
    },
    {
      "id": "dispatch",
      "kind": "builtin.iteration",
      "config": {
        "mode": "parallel",
        "on_error": "terminate",
        "inputs": {
          "origin": "object",
          "tools": {
            "map": "object"
          },
          "flows": {
            "map": "flow"
          }
        },
        "body": {
          "version": "2026-10-28",
          "nodes": [
            {
              "id": "classify",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "call": "object",
                  "origin": "object",
                  "tools": "object"
                },
                "code": {
                  "origin": "origin",
                  "name": "call.name",
                  "ok": "call.name in tools && type(call.arguments) == map && size(call.arguments) == size(call.arguments.transformMap(k, v, k in tools[call.name].interface.allowed, v)) && tools[call.name].interface.required.all(r, r in call.arguments) && tools[call.name].interface.parameters.all(p, !p.secret || p.has_env || p.has_default)",
                  "arguments": "call.name in tools && type(call.arguments) == map ? call.arguments.transformMap(k, v, k in tools[call.name].interface.allowed, v) : {}",
                  "error": "cel.bind(missing, (call.name in tools ? tools[call.name].interface.required.filter(r, !(r in (type(call.arguments) == map ? call.arguments : {}))) : []), {'error': !(call.name in tools) ? 'unknown tool' : type(call.arguments) != map ? 'arguments must be a JSON object' : size(call.arguments) != size(call.arguments.transformMap(k, v, k in tools[call.name].interface.allowed, v)) ? 'unknown or secret argument' : size(missing) > 0 ? 'missing required argument `' + missing[0] + '`' : ''})",
                  "plain": "call.name in tools && tools[call.name].interface.plain"
                }
              },
              "inputs": {
                "call": {
                  "from": {
                    "node": "%iteration",
                    "port": "item"
                  }
                },
                "origin": {
                  "from": {
                    "node": "%iteration",
                    "port": "origin"
                  }
                },
                "tools": {
                  "from": {
                    "node": "%iteration",
                    "port": "tools"
                  }
                }
              }
            },
            {
              "id": "gate",
              "kind": "builtin.if_else",
              "config": {
                "branches": [
                  {
                    "id": "ok",
                    "condition": {
                      "source": {
                        "output": "classify.ok",
                        "path": ""
                      },
                      "operator": "eq",
                      "value": true
                    }
                  }
                ]
              }
            },
            {
              "id": "execute",
              "kind": "builtin.router",
              "config": {
                "mode": "execute"
              },
              "inputs": {
                "flows": {
                  "from": {
                    "node": "%iteration",
                    "port": "flows"
                  }
                },
                "route": {
                  "from": {
                    "node": "classify",
                    "port": "name"
                  }
                },
                "arguments": {
                  "from": {
                    "node": "classify",
                    "port": "arguments"
                  }
                }
              }
            },
            {
              "id": "fail",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "error": "object"
                },
                "code": {
                  "value": "error"
                }
              },
              "inputs": {
                "error": {
                  "from": {
                    "node": "classify",
                    "port": "error"
                  }
                }
              }
            },
            {
              "id": "encode",
              "kind": "llm.tool_result",
              "inputs": {
                "call": {
                  "from": {
                    "node": "%iteration",
                    "port": "item"
                  }
                },
                "plain_content": {
                  "from": {
                    "node": "classify",
                    "port": "plain"
                  }
                },
                "result": {
                  "exclusive": [
                    {
                      "node": "fail",
                      "port": "value"
                    },
                    {
                      "node": "execute",
                      "port": "result"
                    }
                  ]
                }
              }
            }
          ],
          "edges": [
            {
              "from_node": "classify",
              "to_node": "gate"
            },
            {
              "from_node": "gate",
              "from_output": "ok",
              "to_node": "execute"
            },
            {
              "from_node": "gate",
              "from_output": "else",
              "to_node": "fail"
            }
          ],
          "outputs": [
            {
              "name": "result",
              "node": "encode",
              "port": "result"
            }
          ]
        }
      },
      "inputs": {
        "origin": {
          "from": {
            "node": "params",
            "port": "origin"
          }
        },
        "items": {
          "from": {
            "node": "validated_calls",
            "port": "value"
          }
        },
        "tools": {
          "from": {
            "node": "params",
            "port": "tool_properties"
          }
        },
        "flows": {
          "from": {
            "node": "params",
            "port": "tools"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "calls_valid",
      "to_node": "require_calls"
    },
    {
      "from_node": "require_calls",
      "to_node": "validated_calls"
    }
  ],
  "outputs": [
    {
      "name": "results",
      "node": "dispatch",
      "port": "results"
    }
  ]
}
