{
  "version": "2026-11-13",
  "dependencies": {
    "core": {
      "package": "mfn-core"
    },
    "code": {
      "package": "mfn-code"
    },
    "llm": {
      "package": "mfn-llm"
    }
  },
  "flows": {
    "tool-catalog": {
      "builtin": "mfn-llm.tool-catalog"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "prompt": {
            "type": "string"
          },
          "tools": {
            "type": {
              "map": "flow"
            },
            "secret": false
          },
          "system": {
            "type": "string",
            "default": ""
          },
          "history": {
            "type": {
              "list": "object"
            },
            "default": []
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY"
          },
          "tool_properties": {
            "type": {
              "map": "object"
            },
            "secret": false
          }
        }
      }
    },
    {
      "id": "catalog",
      "kind": "workflow.call",
      "config": {
        "flow": "tool-catalog"
      },
      "inputs": {
        "params.properties": {
          "from": {
            "node": "params",
            "port": "tool_properties"
          }
        }
      }
    },
    {
      "id": "initial_messages",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "prompt": "string",
          "system": "string",
          "history": {
            "list": "object"
          }
        },
        "code": {
          "messages": "(system == '' ? [] : [dyn({'role':'system','content':system})]) + history + [dyn({'role':'user','content':prompt})]"
        }
      },
      "inputs": {
        "prompt": {
          "from": {
            "node": "params",
            "port": "prompt"
          }
        },
        "system": {
          "from": {
            "node": "params",
            "port": "system"
          }
        },
        "history": {
          "from": {
            "node": "params",
            "port": "history"
          }
        }
      }
    },
    {
      "id": "repeat",
      "kind": "loop.run",
      "config": {
        "max_iterations": 8,
        "inputs": {
          "api_key": "string",
          "base_url": "string",
          "model": "string",
          "tool_definitions": {
            "list": "object"
          },
          "tools": {
            "map": "flow"
          },
          "tool_properties": {
            "map": "object"
          }
        },
        "variables": [
          {
            "name": "public_messages",
            "type": {
              "list": "object"
            },
            "initial": []
          },
          {
            "name": "messages",
            "type": {
              "list": "object"
            }
          },
          {
            "name": "usages",
            "type": {
              "list": "object"
            },
            "initial": []
          },
          {
            "name": "text",
            "type": "string",
            "initial": ""
          },
          {
            "name": "outcome",
            "type": "string",
            "initial": ""
          },
          {
            "name": "error",
            "type": "string",
            "initial": ""
          }
        ],
        "until": {
          "variable": "outcome",
          "operator": "ne",
          "value": "tool_calls"
        },
        "body": {
          "version": "2026-11-13",
          "dependencies": {},
          "flows": {
            "agent-turn": {
              "builtin": "mfn-llm.agent-turn"
            },
            "tool-uses": {
              "builtin": "mfn-llm.tool-uses"
            }
          },
          "nodes": [
            {
              "id": "turn",
              "kind": "workflow.call",
              "config": {
                "flow": "agent-turn"
              },
              "inputs": {
                "params.messages": {
                  "from": {
                    "node": "%loop",
                    "port": "messages"
                  }
                },
                "params.tools": {
                  "from": {
                    "node": "%loop",
                    "port": "tool_definitions"
                  }
                },
                "params.model": {
                  "from": {
                    "node": "%loop",
                    "port": "model"
                  }
                },
                "params.base_url": {
                  "from": {
                    "node": "%loop",
                    "port": "base_url"
                  }
                },
                "params.api_key": {
                  "from": {
                    "node": "%loop",
                    "port": "api_key"
                  }
                }
              }
            },
            {
              "id": "prepare_origin",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "usages": {
                    "list": "object"
                  }
                },
                "code": {
                  "origin": "size(usages) > 0 ? {'model_call_id': usages[0].call_id} : {}"
                }
              },
              "inputs": {
                "usages": {
                  "from": {
                    "node": "turn",
                    "port": "usages"
                  }
                }
              }
            },
            {
              "id": "prepare_public_assistant",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "message": "object",
                  "messages": {
                    "list": "object"
                  },
                  "usages": {
                    "list": "object"
                  }
                },
                "code": {
                  "messages": "messages + [dyn(message)]",
                  "batch": "{'offset': size(messages), 'model_call_id': size(usages) > 0 ? usages[0].call_id : null, 'messages': [message]}"
                }
              },
              "inputs": {
                "message": {
                  "from": {
                    "node": "turn",
                    "port": "message"
                  }
                },
                "messages": {
                  "from": {
                    "node": "%loop",
                    "port": "public_messages"
                  }
                },
                "usages": {
                  "from": {
                    "node": "turn",
                    "port": "usages"
                  }
                }
              }
            },
            {
              "id": "publish_assistant",
              "kind": "llm.message_events",
              "inputs": {
                "batch": {
                  "from": {
                    "node": "prepare_public_assistant",
                    "port": "batch"
                  }
                }
              }
            },
            {
              "id": "no_tools",
              "kind": "builtin.identity",
              "inputs": {
                "input": {
                  "from": {
                    "node": "prepare_public_assistant",
                    "port": "messages"
                  }
                }
              }
            },
            {
              "id": "public_messages",
              "kind": "builtin.identity",
              "inputs": {
                "input": {
                  "exclusive": [
                    {
                      "node": "no_tools",
                      "port": "value"
                    },
                    {
                      "node": "append_tool_results",
                      "port": "public_messages"
                    }
                  ]
                }
              }
            },
            {
              "id": "publish_results",
              "kind": "llm.message_events",
              "inputs": {
                "batch": {
                  "from": {
                    "node": "append_tool_results",
                    "port": "batch"
                  }
                }
              }
            },
            {
              "id": "collect_usages",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "left": {
                    "list": "object"
                  },
                  "right": {
                    "list": "object"
                  }
                },
                "code": {
                  "value": "left + right"
                }
              },
              "inputs": {
                "left": {
                  "from": {
                    "node": "%loop",
                    "port": "usages"
                  }
                },
                "right": {
                  "from": {
                    "node": "turn",
                    "port": "usages"
                  }
                }
              }
            },
            {
              "id": "route",
              "kind": "builtin.if_else",
              "config": {
                "branches": [
                  {
                    "id": "tool_calls",
                    "condition": {
                      "source": {
                        "output": "turn.outcome",
                        "path": ""
                      },
                      "operator": "eq",
                      "value": "tool_calls"
                    }
                  }
                ]
              }
            },
            {
              "id": "append_assistant",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "messages": {
                    "list": "object"
                  },
                  "message": "object"
                },
                "code": {
                  "messages": "messages + [dyn(message)]"
                }
              },
              "inputs": {
                "messages": {
                  "from": {
                    "node": "%loop",
                    "port": "messages"
                  }
                },
                "message": {
                  "from": {
                    "node": "turn",
                    "port": "message"
                  }
                }
              }
            },
            {
              "id": "dispatch",
              "kind": "workflow.call",
              "config": {
                "flow": "tool-uses"
              },
              "inputs": {
                "params.origin": {
                  "from": {
                    "node": "prepare_origin",
                    "port": "origin"
                  }
                },
                "params.calls": {
                  "from": {
                    "node": "turn",
                    "port": "tool_calls"
                  }
                },
                "params.tools": {
                  "from": {
                    "node": "%loop",
                    "port": "tools"
                  }
                },
                "params.tool_properties": {
                  "from": {
                    "node": "%loop",
                    "port": "tool_properties"
                  }
                }
              }
            },
            {
              "id": "append_tool_results",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "assistant": {
                    "list": "object"
                  },
                  "public_assistant": {
                    "list": "object"
                  },
                  "origin": "object",
                  "results": {
                    "list": "object"
                  }
                },
                "code": {
                  "messages": "assistant + results.map(result, dyn({'role':'tool','tool_call_id':result.tool_call_id,'content':result.content}))",
                  "public_messages": "public_assistant + results.map(result, dyn({'role':'tool','tool_call_id':result.tool_call_id,'content':result.content}))",
                  "batch": "{'offset': size(public_assistant), 'model_call_id': 'model_call_id' in origin ? origin.model_call_id : null, 'messages': results.map(result, dyn({'role':'tool','tool_call_id':result.tool_call_id,'content':result.content}))}"
                }
              },
              "inputs": {
                "public_assistant": {
                  "from": {
                    "node": "prepare_public_assistant",
                    "port": "messages"
                  }
                },
                "origin": {
                  "from": {
                    "node": "prepare_origin",
                    "port": "origin"
                  }
                },
                "assistant": {
                  "from": {
                    "node": "append_assistant",
                    "port": "messages"
                  }
                },
                "results": {
                  "from": {
                    "node": "dispatch",
                    "port": "results"
                  }
                }
              }
            }
          ],
          "edges": [
            {
              "from_node": "route",
              "from_output": "else",
              "to_node": "no_tools"
            },
            {
              "from_node": "publish_assistant",
              "to_node": "dispatch"
            },
            {
              "from_node": "turn",
              "to_node": "route"
            },
            {
              "from_node": "route",
              "from_output": "tool_calls",
              "to_node": "append_assistant"
            },
            {
              "from_node": "append_assistant",
              "to_node": "dispatch"
            }
          ],
          "outputs": [
            {
              "name": "public_messages",
              "node": "public_messages",
              "port": "value",
              "optional": true
            },
            {
              "name": "messages",
              "node": "append_tool_results",
              "port": "messages",
              "optional": true
            },
            {
              "name": "usages",
              "node": "collect_usages",
              "port": "value"
            },
            {
              "name": "text",
              "node": "turn",
              "port": "text"
            },
            {
              "name": "outcome",
              "node": "turn",
              "port": "outcome"
            },
            {
              "name": "error",
              "node": "turn",
              "port": "error",
              "optional": true
            }
          ]
        },
        "stream_outputs": {
          "message_events": {
            "node": "publish_assistant",
            "port": "event"
          },
          "tool_message_events": {
            "node": "publish_results",
            "port": "event"
          },
          "answer": {
            "node": "turn",
            "port": "answer"
          }
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "initial_messages",
            "port": "messages"
          }
        },
        "tool_definitions": {
          "from": {
            "node": "catalog",
            "port": "tools"
          }
        },
        "tools": {
          "from": {
            "node": "params",
            "port": "tools"
          }
        },
        "model": {
          "from": {
            "node": "params",
            "port": "model"
          }
        },
        "base_url": {
          "from": {
            "node": "params",
            "port": "base_url"
          }
        },
        "api_key": {
          "from": {
            "node": "params",
            "port": "api_key"
          }
        },
        "tool_properties": {
          "from": {
            "node": "params",
            "port": "tool_properties"
          }
        }
      }
    },
    {
      "id": "result",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "messages": {
            "list": "object"
          },
          "text": "string",
          "outcome": "string",
          "error": "string",
          "usages": {
            "list": "object"
          }
        },
        "code": {
          "messages": "messages",
          "status": "outcome == 'completed' ? 'succeeded' : 'failed'",
          "text": "text",
          "usages": "usages",
          "error": "outcome == 'tool_calls' ? 'Agent reached the 8-iteration limit with tool calls still pending.' : error != '' ? error : outcome == 'completed' ? '' : 'Agent stopped with outcome `' + outcome + '`.'"
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "repeat",
            "port": "public_messages"
          }
        },
        "text": {
          "from": {
            "node": "repeat",
            "port": "text"
          }
        },
        "outcome": {
          "from": {
            "node": "repeat",
            "port": "outcome"
          }
        },
        "error": {
          "from": {
            "node": "repeat",
            "port": "error"
          }
        },
        "usages": {
          "from": {
            "node": "repeat",
            "port": "usages"
          }
        }
      }
    }
  ],
  "edges": [],
  "outputs": [
    {
      "name": "messages",
      "node": "result",
      "port": "messages"
    },
    {
      "name": "message_events",
      "node": "repeat",
      "port": "message_events",
      "optional": true
    },
    {
      "name": "tool_message_events",
      "node": "repeat",
      "port": "tool_message_events",
      "optional": true
    },
    {
      "name": "answer",
      "node": "repeat",
      "port": "answer",
      "optional": true
    },
    {
      "name": "status",
      "node": "result",
      "port": "status"
    },
    {
      "name": "text",
      "node": "result",
      "port": "text"
    },
    {
      "name": "usages",
      "node": "result",
      "port": "usages"
    },
    {
      "name": "error",
      "node": "result",
      "port": "error",
      "optional": true
    }
  ]
}
