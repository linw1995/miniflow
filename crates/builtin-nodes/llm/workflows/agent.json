{
  "version": "2026-11-13",
  "dependencies": {
    "core": {
      "package": "mfn-core"
    },
    "code": {
      "package": "mfn-code"
    },
    "llm": {
      "package": "mfn-llm"
    }
  },
  "flows": {
    "tool-catalog": {
      "builtin": "mfn-llm.tool-catalog"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "tools": {
            "type": {
              "map": "flow"
            },
            "secret": false
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY"
          },
          "compact": {
            "type": "flow",
            "required": false,
            "secret": false
          },
          "tool_properties": {
            "type": {
              "map": "object"
            },
            "secret": false
          }
        }
      }
    },
    {
      "id": "catalog",
      "kind": "workflow.call",
      "config": {
        "flow": "tool-catalog"
      },
      "inputs": {
        "params.properties": {
          "from": {
            "node": "params",
            "port": "tool_properties"
          }
        }
      }
    },
    {
      "id": "policy_route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "absent",
            "condition": {
              "source": {
                "output": "params.compact",
                "path": ""
              },
              "operator": "not_exists"
            }
          }
        ]
      }
    },
    {
      "id": "use_policy",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "from": {
            "node": "params",
            "port": "compact"
          }
        }
      }
    },
    {
      "id": "no_policy",
      "kind": "builtin.constant",
      "config": {
        "value": null
      }
    },
    {
      "id": "repeat",
      "kind": "loop.run",
      "config": {
        "inputs": {
          "prefix": {
            "list": "object"
          },
          "compact": {
            "nullable": "flow"
          },
          "api_key": "string",
          "base_url": "string",
          "model": "string",
          "tool_definitions": {
            "list": "object"
          },
          "tools": {
            "map": "flow"
          },
          "tool_properties": {
            "map": "object"
          }
        },
        "variables": [
          {
            "name": "checkpoint",
            "type": "object",
            "initial": {}
          },
          {
            "name": "generated",
            "type": {
              "list": "object"
            },
            "initial": []
          },
          {
            "name": "usages",
            "type": {
              "list": "object"
            },
            "initial": []
          },
          {
            "name": "text",
            "type": "string",
            "initial": ""
          },
          {
            "name": "outcome",
            "type": "string",
            "initial": ""
          },
          {
            "name": "error",
            "type": "string",
            "initial": ""
          }
        ],
        "until": {
          "variable": "outcome",
          "operator": "ne",
          "value": "tool_calls"
        },
        "body": {
          "version": "2026-11-13",
          "dependencies": {},
          "flows": {
            "agent-request": {
              "builtin": "mfn-llm.agent-request"
            },
            "agent-turn": {
              "builtin": "mfn-llm.agent-turn"
            },
            "tool-uses": {
              "builtin": "mfn-llm.tool-uses"
            }
          },
          "nodes": [
            {
              "id": "request",
              "kind": "workflow.call",
              "config": {
                "flow": "agent-request"
              },
              "inputs": {
                "params.checkpoint": {
                  "from": {
                    "node": "%loop",
                    "port": "checkpoint"
                  }
                },
                "params.prefix": {
                  "from": {
                    "node": "%loop",
                    "port": "prefix"
                  }
                },
                "params.generated": {
                  "from": {
                    "node": "%loop",
                    "port": "generated"
                  }
                }
              }
            },
            {
              "id": "turn",
              "kind": "workflow.call",
              "config": {
                "flow": "agent-turn"
              },
              "inputs": {
                "params.messages": {
                  "from": {
                    "node": "request",
                    "port": "messages"
                  }
                },
                "params.tools": {
                  "from": {
                    "node": "%loop",
                    "port": "tool_definitions"
                  }
                },
                "params.model": {
                  "from": {
                    "node": "%loop",
                    "port": "model"
                  }
                },
                "params.base_url": {
                  "from": {
                    "node": "%loop",
                    "port": "base_url"
                  }
                },
                "params.api_key": {
                  "from": {
                    "node": "%loop",
                    "port": "api_key"
                  }
                }
              }
            },
            {
              "id": "collect_usages",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "left": {
                    "list": "object"
                  },
                  "right": {
                    "list": "object"
                  }
                },
                "code": {
                  "model_call_id": "size(right) > 0 ? string(right[0].call_id) : ''",
                  "value": "left + right"
                }
              },
              "inputs": {
                "left": {
                  "from": {
                    "node": "%loop",
                    "port": "usages"
                  }
                },
                "right": {
                  "from": {
                    "node": "turn",
                    "port": "usages"
                  }
                }
              }
            },
            {
              "id": "route",
              "kind": "builtin.if_else",
              "config": {
                "branches": [
                  {
                    "id": "tool_calls",
                    "condition": {
                      "source": {
                        "output": "turn.outcome",
                        "path": ""
                      },
                      "operator": "eq",
                      "value": "tool_calls"
                    }
                  }
                ]
              }
            },
            {
              "id": "append_assistant",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "generated": {
                    "list": "object"
                  },
                  "additions": {
                    "list": "object"
                  }
                },
                "code": {
                  "generated": "generated + additions"
                }
              },
              "inputs": {
                "generated": {
                  "from": {
                    "node": "%loop",
                    "port": "generated"
                  }
                },
                "additions": {
                  "from": {
                    "node": "turn",
                    "port": "messages"
                  }
                }
              }
            },
            {
              "id": "dispatch",
              "kind": "workflow.call",
              "config": {
                "flow": "tool-uses"
              },
              "inputs": {
                "params.model_call_id": {
                  "from": {
                    "node": "collect_usages",
                    "port": "model_call_id"
                  }
                },
                "params.calls": {
                  "from": {
                    "node": "turn",
                    "port": "tool_calls"
                  }
                },
                "params.tools": {
                  "from": {
                    "node": "%loop",
                    "port": "tools"
                  }
                },
                "params.tool_properties": {
                  "from": {
                    "node": "%loop",
                    "port": "tool_properties"
                  }
                }
              }
            },
            {
              "id": "append_tool_results",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "generated": {
                    "list": "object"
                  },
                  "results": {
                    "list": "object"
                  }
                },
                "code": {
                  "through": "size(generated) + size(results)",
                  "generated": "generated + results.map(result, dyn({'role':'tool','tool_call_id':result.tool_call_id,'content':result.content}))"
                }
              },
              "inputs": {
                "generated": {
                  "from": {
                    "node": "append_assistant",
                    "port": "generated"
                  }
                },
                "results": {
                  "from": {
                    "node": "dispatch",
                    "port": "results"
                  }
                }
              }
            },
            {
              "id": "check_budget",
              "kind": "builtin.if_else",
              "config": {
                "branches": [
                  {
                    "id": "finished",
                    "condition": {
                      "source": {
                        "output": "turn.outcome",
                        "path": ""
                      },
                      "operator": "ne",
                      "value": "tool_calls"
                    }
                  },
                  {
                    "id": "unmanaged",
                    "condition": {
                      "source": {
                        "output": "%loop.compact",
                        "path": ""
                      },
                      "operator": "eq",
                      "value": null
                    }
                  }
                ]
              }
            },
            {
              "id": "finished_facts",
              "kind": "builtin.constant",
              "config": {
                "value": {
                  "error": "",
                  "usages": []
                }
              }
            },
            {
              "id": "no_compaction",
              "kind": "builtin.constant",
              "config": {
                "value": {
                  "error": "",
                  "usages": []
                }
              }
            },
            {
              "id": "compact",
              "kind": "workflow.call",
              "config": {
                "inputs": [
                  {
                    "name": "params.generated",
                    "value_type": {
                      "list": "object"
                    },
                    "required": true
                  },
                  {
                    "name": "params.checkpoint",
                    "value_type": "object",
                    "required": true
                  },
                  {
                    "name": "params.usages",
                    "value_type": {
                      "list": "object"
                    },
                    "required": true
                  }
                ],
                "outputs": [
                  {
                    "name": "result",
                    "value_type": {
                      "map": "any"
                    },
                    "required": true
                  }
                ]
              },
              "inputs": {
                "flow": {
                  "from": {
                    "node": "%loop",
                    "port": "compact"
                  }
                },
                "params.generated": {
                  "from": {
                    "node": "append_tool_results",
                    "port": "generated"
                  }
                },
                "params.checkpoint": {
                  "from": {
                    "node": "%loop",
                    "port": "checkpoint"
                  }
                },
                "params.usages": {
                  "from": {
                    "node": "turn",
                    "port": "usages"
                  }
                }
              }
            },
            {
              "id": "checkpoint",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "previous": "object",
                  "through": "int",
                  "report": "object"
                },
                "code": {
                  "value": "report.replacement == null ? dyn(previous) : dyn(report.replacement + {'through':through})",
                  "error": "string(report.error)",
                  "facts": "{'error':report.error, 'usages':report.usages}"
                }
              },
              "inputs": {
                "previous": {
                  "from": {
                    "node": "%loop",
                    "port": "checkpoint"
                  }
                },
                "through": {
                  "from": {
                    "node": "append_tool_results",
                    "port": "through"
                  }
                },
                "report": {
                  "from": {
                    "node": "compact",
                    "port": "result"
                  }
                }
              }
            },
            {
              "id": "record_pass",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "outcome": "string",
                  "usages": {
                    "list": "object"
                  },
                  "facts": "object"
                },
                "code": {
                  "outcome": "facts.error != '' ? 'compaction_failed' : outcome",
                  "usages": "usages + facts.usages"
                }
              },
              "inputs": {
                "outcome": {
                  "from": {
                    "node": "turn",
                    "port": "outcome"
                  }
                },
                "usages": {
                  "from": {
                    "node": "collect_usages",
                    "port": "value"
                  }
                },
                "facts": {
                  "exclusive": [
                    {
                      "node": "checkpoint",
                      "port": "facts"
                    },
                    {
                      "node": "finished_facts",
                      "port": "value"
                    },
                    {
                      "node": "no_compaction",
                      "port": "value"
                    }
                  ]
                }
              }
            },
            {
              "id": "provider_error",
              "kind": "builtin.identity",
              "inputs": {
                "input": {
                  "from": {
                    "node": "turn",
                    "port": "error"
                  }
                }
              }
            },
            {
              "id": "pass_error",
              "kind": "builtin.identity",
              "inputs": {
                "input": {
                  "exclusive": [
                    {
                      "node": "checkpoint",
                      "port": "error"
                    },
                    {
                      "node": "provider_error",
                      "port": "value"
                    }
                  ]
                }
              }
            },
            {
              "id": "finished_generated",
              "kind": "builtin.identity",
              "inputs": {
                "input": {
                  "from": {
                    "node": "append_assistant",
                    "port": "generated"
                  }
                }
              }
            },
            {
              "id": "generated",
              "kind": "builtin.identity",
              "inputs": {
                "input": {
                  "exclusive": [
                    {
                      "node": "append_tool_results",
                      "port": "generated"
                    },
                    {
                      "node": "finished_generated",
                      "port": "value"
                    }
                  ]
                }
              }
            }
          ],
          "edges": [
            {
              "from_node": "check_budget",
              "from_output": "finished",
              "to_node": "provider_error"
            },
            {
              "from_node": "turn",
              "to_node": "check_budget"
            },
            {
              "from_node": "check_budget",
              "from_output": "else",
              "to_node": "compact"
            },
            {
              "from_node": "check_budget",
              "from_output": "finished",
              "to_node": "finished_facts"
            },
            {
              "from_node": "check_budget",
              "from_output": "unmanaged",
              "to_node": "no_compaction"
            },
            {
              "from_node": "turn",
              "to_node": "route"
            },
            {
              "from_node": "route",
              "from_output": "tool_calls",
              "to_node": "dispatch"
            },
            {
              "from_node": "route",
              "from_output": "else",
              "to_node": "finished_generated"
            },
            {
              "from_node": "append_assistant",
              "to_node": "dispatch"
            }
          ],
          "clusters": [
            {
              "label": "Handle reply",
              "annotation": "Append the assistant message and decide whether to dispatch tools.",
              "collapsed": true,
              "nodes": [
                "route",
                "append_assistant"
              ]
            },
            {
              "label": "Check context budget",
              "annotation": "Check the caller's policy after a complete tool batch, before the next request.",
              "collapsed": true,
              "nodes": [
                "check_budget",
                "finished_facts",
                "no_compaction",
                "compact",
                "checkpoint"
              ]
            },
            {
              "label": "Record turn",
              "annotation": "Retain the generated transcript, usages and outcome from the completed pass.",
              "collapsed": true,
              "nodes": [
                "collect_usages",
                "append_tool_results",
                "record_pass",
                "provider_error",
                "pass_error",
                "finished_generated",
                "generated"
              ]
            }
          ],
          "outputs": [
            {
              "name": "generated",
              "node": "generated",
              "port": "value"
            },
            {
              "name": "checkpoint",
              "node": "checkpoint",
              "port": "value",
              "optional": true
            },
            {
              "name": "usages",
              "node": "record_pass",
              "port": "usages"
            },
            {
              "name": "text",
              "node": "turn",
              "port": "text"
            },
            {
              "name": "outcome",
              "node": "record_pass",
              "port": "outcome"
            },
            {
              "name": "error",
              "node": "pass_error",
              "port": "value",
              "optional": true
            }
          ]
        },
        "stream_outputs": {
          "tool_output": {
            "node": "dispatch",
            "port": "tool_output"
          },
          "tool_call_delta": {
            "node": "turn",
            "port": "tool_call_delta"
          },
          "answer": {
            "node": "turn",
            "port": "answer"
          }
        }
      },
      "inputs": {
        "compact": {
          "exclusive": [
            {
              "node": "use_policy",
              "port": "value"
            },
            {
              "node": "no_policy",
              "port": "value"
            }
          ]
        },
        "prefix": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        },
        "tool_definitions": {
          "from": {
            "node": "catalog",
            "port": "tools"
          }
        },
        "tools": {
          "from": {
            "node": "params",
            "port": "tools"
          }
        },
        "model": {
          "from": {
            "node": "params",
            "port": "model"
          }
        },
        "base_url": {
          "from": {
            "node": "params",
            "port": "base_url"
          }
        },
        "api_key": {
          "from": {
            "node": "params",
            "port": "api_key"
          }
        },
        "tool_properties": {
          "from": {
            "node": "params",
            "port": "tool_properties"
          }
        }
      }
    },
    {
      "id": "result",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "text": "string",
          "outcome": "string",
          "error": "string",
          "usages": {
            "list": "object"
          }
        },
        "code": {
          "status": "outcome == 'completed' ? 'succeeded' : 'failed'",
          "text": "text",
          "usages": "usages",
          "error": "error != '' ? error : outcome == 'completed' ? '' : 'Agent stopped with outcome `' + outcome + '`.'"
        }
      },
      "inputs": {
        "text": {
          "from": {
            "node": "repeat",
            "port": "text"
          }
        },
        "outcome": {
          "from": {
            "node": "repeat",
            "port": "outcome"
          }
        },
        "error": {
          "from": {
            "node": "repeat",
            "port": "error"
          }
        },
        "usages": {
          "from": {
            "node": "repeat",
            "port": "usages"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "policy_route",
      "from_output": "else",
      "to_node": "use_policy"
    },
    {
      "from_node": "params",
      "to_node": "policy_route"
    },
    {
      "from_node": "policy_route",
      "from_output": "absent",
      "to_node": "no_policy"
    }
  ],
  "clusters": [
    {
      "label": "Prepare agent",
      "annotation": "Prepare the request, tool catalog and optional context policy once.",
      "collapsed": true,
      "nodes": [
        "params",
        "catalog",
        "policy_route",
        "use_policy",
        "no_policy"
      ]
    }
  ],
  "outputs": [
    {
      "name": "checkpoint",
      "node": "repeat",
      "port": "checkpoint"
    },
    {
      "name": "tool_output",
      "node": "repeat",
      "port": "tool_output",
      "optional": true
    },
    {
      "name": "tool_call_delta",
      "node": "repeat",
      "port": "tool_call_delta",
      "optional": true
    },
    {
      "name": "answer",
      "node": "repeat",
      "port": "answer",
      "optional": true
    },
    {
      "name": "status",
      "node": "result",
      "port": "status"
    },
    {
      "name": "text",
      "node": "result",
      "port": "text"
    },
    {
      "name": "messages",
      "node": "repeat",
      "port": "generated"
    },
    {
      "name": "usages",
      "node": "result",
      "port": "usages"
    },
    {
      "name": "error",
      "node": "result",
      "port": "error",
      "optional": true
    }
  ]
}
