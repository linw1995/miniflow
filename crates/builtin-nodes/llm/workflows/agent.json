{
  "version": "2026-11-13",
  "dependencies": {
    "core": {
      "package": "mfn-core"
    },
    "code": {
      "package": "mfn-code"
    },
    "llm": {
      "package": "mfn-llm"
    }
  },
  "flows": {
    "tool-catalog": {
      "builtin": "mfn-llm.tool-catalog"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "messages": {
            "type": {
              "list": "object"
            }
          },
          "tools": {
            "type": {
              "map": "flow"
            },
            "secret": false
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY"
          },
          "tool_properties": {
            "type": {
              "map": "object"
            },
            "secret": false
          }
        }
      }
    },
    {
      "id": "catalog",
      "kind": "workflow.call",
      "config": {
        "flow": "tool-catalog"
      },
      "inputs": {
        "params.properties": {
          "from": {
            "node": "params",
            "port": "tool_properties"
          }
        }
      }
    },
    {
      "id": "repeat",
      "kind": "loop.run",
      "config": {
        "max_iterations": 8,
        "inputs": {
          "prefix": {
            "list": "object"
          },
          "api_key": "string",
          "base_url": "string",
          "model": "string",
          "tool_definitions": {
            "list": "object"
          },
          "tools": {
            "map": "flow"
          },
          "tool_properties": {
            "map": "object"
          }
        },
        "variables": [
          {
            "name": "generated",
            "type": {
              "list": "object"
            },
            "initial": []
          },
          {
            "name": "usages",
            "type": {
              "list": "object"
            },
            "initial": []
          },
          {
            "name": "text",
            "type": "string",
            "initial": ""
          },
          {
            "name": "outcome",
            "type": "string",
            "initial": ""
          },
          {
            "name": "error",
            "type": "string",
            "initial": ""
          }
        ],
        "until": {
          "variable": "outcome",
          "operator": "ne",
          "value": "tool_calls"
        },
        "body": {
          "version": "2026-11-13",
          "dependencies": {},
          "flows": {
            "agent-request": {
              "builtin": "mfn-llm.agent-request"
            },
            "agent-turn": {
              "builtin": "mfn-llm.agent-turn"
            },
            "tool-uses": {
              "builtin": "mfn-llm.tool-uses"
            }
          },
          "nodes": [
            {
              "id": "request",
              "kind": "workflow.call",
              "config": {
                "flow": "agent-request"
              },
              "inputs": {
                "params.prefix": {
                  "from": {
                    "node": "%loop",
                    "port": "prefix"
                  }
                },
                "params.generated": {
                  "from": {
                    "node": "%loop",
                    "port": "generated"
                  }
                }
              }
            },
            {
              "id": "turn",
              "kind": "workflow.call",
              "config": {
                "flow": "agent-turn"
              },
              "inputs": {
                "params.messages": {
                  "from": {
                    "node": "request",
                    "port": "messages"
                  }
                },
                "params.tools": {
                  "from": {
                    "node": "%loop",
                    "port": "tool_definitions"
                  }
                },
                "params.model": {
                  "from": {
                    "node": "%loop",
                    "port": "model"
                  }
                },
                "params.base_url": {
                  "from": {
                    "node": "%loop",
                    "port": "base_url"
                  }
                },
                "params.api_key": {
                  "from": {
                    "node": "%loop",
                    "port": "api_key"
                  }
                }
              }
            },
            {
              "id": "collect_usages",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "left": {
                    "list": "object"
                  },
                  "right": {
                    "list": "object"
                  }
                },
                "code": {
                  "value": "left + right"
                }
              },
              "inputs": {
                "left": {
                  "from": {
                    "node": "%loop",
                    "port": "usages"
                  }
                },
                "right": {
                  "from": {
                    "node": "turn",
                    "port": "usages"
                  }
                }
              }
            },
            {
              "id": "route",
              "kind": "builtin.if_else",
              "config": {
                "branches": [
                  {
                    "id": "tool_calls",
                    "condition": {
                      "source": {
                        "output": "turn.outcome",
                        "path": ""
                      },
                      "operator": "eq",
                      "value": "tool_calls"
                    }
                  }
                ]
              }
            },
            {
              "id": "append_assistant",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "messages": {
                    "list": "object"
                  },
                  "generated": {
                    "list": "object"
                  },
                  "additions": {
                    "list": "object"
                  }
                },
                "code": {
                  "messages": "messages + additions",
                  "generated": "generated + additions"
                }
              },
              "inputs": {
                "messages": {
                  "from": {
                    "node": "request",
                    "port": "messages"
                  }
                },
                "generated": {
                  "from": {
                    "node": "%loop",
                    "port": "generated"
                  }
                },
                "additions": {
                  "from": {
                    "node": "turn",
                    "port": "messages"
                  }
                }
              }
            },
            {
              "id": "dispatch",
              "kind": "workflow.call",
              "config": {
                "flow": "tool-uses"
              },
              "inputs": {
                "params.calls": {
                  "from": {
                    "node": "turn",
                    "port": "tool_calls"
                  }
                },
                "params.tools": {
                  "from": {
                    "node": "%loop",
                    "port": "tools"
                  }
                },
                "params.tool_properties": {
                  "from": {
                    "node": "%loop",
                    "port": "tool_properties"
                  }
                }
              }
            },
            {
              "id": "append_tool_results",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "assistant": {
                    "list": "object"
                  },
                  "generated": {
                    "list": "object"
                  },
                  "results": {
                    "list": "object"
                  }
                },
                "code": {
                  "messages": "assistant + results.map(result, dyn({'role':'tool','tool_call_id':result.tool_call_id,'content':result.content}))",
                  "generated": "generated + results.map(result, dyn({'role':'tool','tool_call_id':result.tool_call_id,'content':result.content}))"
                }
              },
              "inputs": {
                "assistant": {
                  "from": {
                    "node": "append_assistant",
                    "port": "messages"
                  }
                },
                "generated": {
                  "from": {
                    "node": "append_assistant",
                    "port": "generated"
                  }
                },
                "results": {
                  "from": {
                    "node": "dispatch",
                    "port": "results"
                  }
                }
              }
            },
            {
              "id": "finished_generated",
              "kind": "builtin.identity",
              "inputs": {
                "input": {
                  "from": {
                    "node": "append_assistant",
                    "port": "generated"
                  }
                }
              }
            },
            {
              "id": "generated",
              "kind": "builtin.identity",
              "inputs": {
                "input": {
                  "exclusive": [
                    {
                      "node": "append_tool_results",
                      "port": "generated"
                    },
                    {
                      "node": "finished_generated",
                      "port": "value"
                    }
                  ]
                }
              }
            }
          ],
          "edges": [
            {
              "from_node": "turn",
              "to_node": "route"
            },
            {
              "from_node": "route",
              "from_output": "tool_calls",
              "to_node": "dispatch"
            },
            {
              "from_node": "route",
              "from_output": "else",
              "to_node": "finished_generated"
            },
            {
              "from_node": "append_assistant",
              "to_node": "dispatch"
            }
          ],
          "clusters": [
            {
              "label": "Handle reply",
              "annotation": "Append the assistant message and decide whether to dispatch tools.",
              "collapsed": true,
              "nodes": [
                "route",
                "append_assistant"
              ]
            },
            {
              "label": "Record turn",
              "annotation": "Retain usage and the generated messages from either branch.",
              "collapsed": true,
              "nodes": [
                "collect_usages",
                "append_tool_results",
                "finished_generated",
                "generated"
              ]
            }
          ],
          "outputs": [
            {
              "name": "generated",
              "node": "generated",
              "port": "value"
            },
            {
              "name": "usages",
              "node": "collect_usages",
              "port": "value"
            },
            {
              "name": "text",
              "node": "turn",
              "port": "text"
            },
            {
              "name": "outcome",
              "node": "turn",
              "port": "outcome"
            },
            {
              "name": "error",
              "node": "turn",
              "port": "error",
              "optional": true
            }
          ]
        },
        "stream_outputs": {
          "tool_call_delta": {
            "node": "turn",
            "port": "tool_call_delta"
          },
          "answer": {
            "node": "turn",
            "port": "answer"
          }
        }
      },
      "inputs": {
        "prefix": {
          "from": {
            "node": "params",
            "port": "messages"
          }
        },
        "tool_definitions": {
          "from": {
            "node": "catalog",
            "port": "tools"
          }
        },
        "tools": {
          "from": {
            "node": "params",
            "port": "tools"
          }
        },
        "model": {
          "from": {
            "node": "params",
            "port": "model"
          }
        },
        "base_url": {
          "from": {
            "node": "params",
            "port": "base_url"
          }
        },
        "api_key": {
          "from": {
            "node": "params",
            "port": "api_key"
          }
        },
        "tool_properties": {
          "from": {
            "node": "params",
            "port": "tool_properties"
          }
        }
      }
    },
    {
      "id": "result",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "text": "string",
          "outcome": "string",
          "error": "string",
          "usages": {
            "list": "object"
          }
        },
        "code": {
          "status": "outcome == 'completed' ? 'succeeded' : 'failed'",
          "text": "text",
          "usages": "usages",
          "error": "outcome == 'tool_calls' ? 'Agent reached the 8-iteration limit with tool calls still pending.' : error != '' ? error : outcome == 'completed' ? '' : 'Agent stopped with outcome `' + outcome + '`.'"
        }
      },
      "inputs": {
        "text": {
          "from": {
            "node": "repeat",
            "port": "text"
          }
        },
        "outcome": {
          "from": {
            "node": "repeat",
            "port": "outcome"
          }
        },
        "error": {
          "from": {
            "node": "repeat",
            "port": "error"
          }
        },
        "usages": {
          "from": {
            "node": "repeat",
            "port": "usages"
          }
        }
      }
    }
  ],
  "edges": [],
  "clusters": [
    {
      "label": "Prepare agent",
      "annotation": "Read the request and build the tool catalog once.",
      "collapsed": true,
      "nodes": [
        "params",
        "catalog"
      ]
    }
  ],
  "outputs": [
    {
      "name": "tool_call_delta",
      "node": "repeat",
      "port": "tool_call_delta",
      "optional": true
    },
    {
      "name": "answer",
      "node": "repeat",
      "port": "answer",
      "optional": true
    },
    {
      "name": "status",
      "node": "result",
      "port": "status"
    },
    {
      "name": "text",
      "node": "result",
      "port": "text"
    },
    {
      "name": "messages",
      "node": "repeat",
      "port": "generated"
    },
    {
      "name": "usages",
      "node": "result",
      "port": "usages"
    },
    {
      "name": "error",
      "node": "result",
      "port": "error",
      "optional": true
    }
  ]
}
