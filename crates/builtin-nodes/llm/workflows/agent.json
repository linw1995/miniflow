{
  "version": "2026-11-11",
  "dependencies": {
    "core": {
      "package": "mfn-core"
    },
    "code": {
      "package": "mfn-code"
    },
    "llm": {
      "package": "mfn-llm"
    }
  },
  "flows": {
    "tool-catalog": {
      "builtin": "mfn-llm.tool-catalog"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "prompt": {
            "type": "string"
          },
          "tools": {
            "type": {
              "map": "object"
            },
            "secret": false
          },
          "system": {
            "type": "string",
            "default": ""
          },
          "history": {
            "type": {
              "list": "object"
            },
            "default": []
          },
          "model": {
            "type": "string",
            "default": "your-model",
            "secret": false
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "secret": false
          },
          "api_key": {
            "type": "string",
            "env": "OPENAI_API_KEY"
          }
        }
      }
    },
    {
      "id": "catalog",
      "kind": "workflow.call",
      "config": {
        "flow": "tool-catalog"
      },
      "inputs": {
        "params.tools": {
          "from": {
            "node": "params",
            "port": "tools"
          }
        }
      }
    },
    {
      "id": "initial_messages",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "prompt": "string",
          "system": "string",
          "history": {
            "list": "object"
          }
        },
        "code": {
          "messages": "(system == '' ? [] : [dyn({'role':'system','content':system})]) + history + [dyn({'role':'user','content':prompt})]"
        }
      },
      "inputs": {
        "prompt": {
          "from": {
            "node": "params",
            "port": "prompt"
          }
        },
        "system": {
          "from": {
            "node": "params",
            "port": "system"
          }
        },
        "history": {
          "from": {
            "node": "params",
            "port": "history"
          }
        }
      }
    },
    {
      "id": "repeat",
      "kind": "workflow.loop",
      "config": {
        "max_iterations": 8,
        "inputs": {
          "api_key": "string",
          "base_url": "string",
          "model": "string",
          "tool_definitions": {
            "list": "object"
          },
          "tools": {
            "map": "object"
          }
        },
        "variables": [
          {
            "name": "messages",
            "type": {
              "list": "object"
            }
          },
          {
            "name": "usages",
            "type": {
              "list": "object"
            },
            "initial": []
          },
          {
            "name": "text",
            "type": "string",
            "initial": ""
          },
          {
            "name": "outcome",
            "type": "string",
            "initial": ""
          },
          {
            "name": "error",
            "type": "string",
            "initial": ""
          }
        ],
        "until": {
          "variable": "outcome",
          "operator": "ne",
          "value": "tool_calls"
        },
        "body": {
          "version": "2026-10-28",
          "dependencies": {},
          "flows": {
            "agent-turn": {
              "builtin": "mfn-llm.agent-turn"
            },
            "tool-uses": {
              "builtin": "mfn-llm.tool-uses"
            }
          },
          "nodes": [
            {
              "id": "turn",
              "kind": "workflow.call",
              "config": {
                "flow": "agent-turn"
              },
              "inputs": {
                "params.messages": {
                  "from": {
                    "node": "%loop",
                    "port": "messages"
                  }
                },
                "params.tools": {
                  "from": {
                    "node": "%loop",
                    "port": "tool_definitions"
                  }
                },
                "params.model": {
                  "from": {
                    "node": "%loop",
                    "port": "model"
                  }
                },
                "params.base_url": {
                  "from": {
                    "node": "%loop",
                    "port": "base_url"
                  }
                },
                "params.api_key": {
                  "from": {
                    "node": "%loop",
                    "port": "api_key"
                  }
                }
              }
            },
            {
              "id": "collect_usages",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "left": {
                    "list": "object"
                  },
                  "right": {
                    "list": "object"
                  }
                },
                "code": {
                  "value": "left + right"
                }
              },
              "inputs": {
                "left": {
                  "from": {
                    "node": "%loop",
                    "port": "usages"
                  }
                },
                "right": {
                  "from": {
                    "node": "turn",
                    "port": "usages"
                  }
                }
              }
            },
            {
              "id": "route",
              "kind": "builtin.if_else",
              "config": {
                "branches": [
                  {
                    "id": "tool_calls",
                    "condition": {
                      "source": {
                        "output": "turn.outcome",
                        "path": ""
                      },
                      "operator": "eq",
                      "value": "tool_calls"
                    }
                  }
                ]
              }
            },
            {
              "id": "append_assistant",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "messages": {
                    "list": "object"
                  },
                  "message": "object"
                },
                "code": {
                  "messages": "messages + [dyn(message)]"
                }
              },
              "inputs": {
                "messages": {
                  "from": {
                    "node": "%loop",
                    "port": "messages"
                  }
                },
                "message": {
                  "from": {
                    "node": "turn",
                    "port": "message"
                  }
                }
              }
            },
            {
              "id": "dispatch",
              "kind": "workflow.call",
              "config": {
                "flow": "tool-uses"
              },
              "inputs": {
                "params.calls": {
                  "from": {
                    "node": "turn",
                    "port": "tool_calls"
                  }
                },
                "params.tools": {
                  "from": {
                    "node": "%loop",
                    "port": "tools"
                  }
                }
              }
            },
            {
              "id": "append_tool_results",
              "kind": "builtin.code",
              "config": {
                "language": "cel",
                "inputs": {
                  "assistant": {
                    "list": "object"
                  },
                  "results": {
                    "list": "object"
                  }
                },
                "code": {
                  "messages": "assistant + results.map(result, dyn({'role':'tool','tool_call_id':result.tool_call_id,'content':result.content}))"
                }
              },
              "inputs": {
                "assistant": {
                  "from": {
                    "node": "append_assistant",
                    "port": "messages"
                  }
                },
                "results": {
                  "from": {
                    "node": "dispatch",
                    "port": "results"
                  }
                }
              }
            },
            {
              "id": "save_messages",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "messages"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "append_tool_results",
                    "port": "messages"
                  }
                }
              }
            },
            {
              "id": "save_usages",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "usages"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "collect_usages",
                    "port": "value"
                  }
                }
              }
            },
            {
              "id": "save_text",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "text"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "turn",
                    "port": "text"
                  }
                }
              }
            },
            {
              "id": "save_outcome",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "outcome"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "turn",
                    "port": "outcome"
                  }
                }
              }
            },
            {
              "id": "save_error",
              "kind": "workflow.loop_assign",
              "config": {
                "variable": "error"
              },
              "inputs": {
                "value": {
                  "from": {
                    "node": "turn",
                    "port": "error"
                  }
                }
              }
            }
          ],
          "edges": [
            {
              "from_node": "turn",
              "to_node": "route"
            },
            {
              "from_node": "route",
              "from_output": "tool_calls",
              "to_node": "append_assistant"
            },
            {
              "from_node": "append_assistant",
              "to_node": "dispatch"
            }
          ],
          "outputs": []
        },
        "stream_outputs": {
          "answer": {
            "node": "turn",
            "port": "answer"
          }
        }
      },
      "inputs": {
        "messages": {
          "from": {
            "node": "initial_messages",
            "port": "messages"
          }
        },
        "tool_definitions": {
          "from": {
            "node": "catalog",
            "port": "tools"
          }
        },
        "tools": {
          "from": {
            "node": "params",
            "port": "tools"
          }
        },
        "model": {
          "from": {
            "node": "params",
            "port": "model"
          }
        },
        "base_url": {
          "from": {
            "node": "params",
            "port": "base_url"
          }
        },
        "api_key": {
          "from": {
            "node": "params",
            "port": "api_key"
          }
        }
      }
    },
    {
      "id": "result",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "text": "string",
          "outcome": "string",
          "error": "string",
          "usages": {
            "list": "object"
          }
        },
        "code": {
          "status": "outcome == 'completed' ? 'succeeded' : 'failed'",
          "text": "text",
          "usages": "usages",
          "error": "outcome == 'tool_calls' ? 'Agent reached the 8-iteration limit with tool calls still pending.' : error != '' ? error : outcome == 'completed' ? '' : 'Agent stopped with outcome `' + outcome + '`.'"
        }
      },
      "inputs": {
        "text": {
          "from": {
            "node": "repeat",
            "port": "text"
          }
        },
        "outcome": {
          "from": {
            "node": "repeat",
            "port": "outcome"
          }
        },
        "error": {
          "from": {
            "node": "repeat",
            "port": "error"
          }
        },
        "usages": {
          "from": {
            "node": "repeat",
            "port": "usages"
          }
        }
      }
    }
  ],
  "edges": [],
  "outputs": [
    {
      "name": "answer",
      "node": "repeat",
      "port": "answer",
      "optional": true
    },
    {
      "name": "status",
      "node": "result",
      "port": "status"
    },
    {
      "name": "text",
      "node": "result",
      "port": "text"
    },
    {
      "name": "usages",
      "node": "result",
      "port": "usages"
    },
    {
      "name": "error",
      "node": "result",
      "port": "error",
      "optional": true
    }
  ]
}
