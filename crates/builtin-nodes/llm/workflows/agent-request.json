{
  "version": "2026-11-28",
  "dependencies": {
    "core": {
      "package": "mfn-core"
    },
    "code": {
      "package": "mfn-code"
    }
  },
  "nodes": [
    {
      "id": "params",
      "kind": "builtin.parameters",
      "config": {
        "parameters": {
          "prefix": {
            "type": {
              "list": "object"
            },
            "secret": false
          },
          "checkpoint": {
            "type": "object",
            "default": {}
          },
          "generated": {
            "type": {
              "list": "object"
            },
            "secret": false
          }
        }
      }
    },
    {
      "id": "route",
      "kind": "builtin.if_else",
      "config": {
        "branches": [
          {
            "id": "prefix_only",
            "condition": {
              "source": {
                "output": "params.generated",
                "path": "/0"
              },
              "operator": "not_exists"
            }
          }
        ]
      }
    },
    {
      "id": "prefix_only",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "$ref": "params.prefix"
        }
      }
    },
    {
      "id": "continue_request",
      "kind": "builtin.code",
      "config": {
        "language": "cel",
        "inputs": {
          "prefix": {
            "list": "object"
          },
          "generated": {
            "list": "object"
          },
          "checkpoint": "object"
        },
        "code": {
          "messages": "has(checkpoint.through) ? checkpoint.request + generated.slice(int(checkpoint.through), size(generated)) : prefix + generated"
        }
      },
      "inputs": {
        "prefix": {
          "$ref": "params.prefix"
        },
        "checkpoint": {
          "$ref": "params.checkpoint"
        },
        "generated": {
          "$ref": "params.generated"
        }
      }
    },
    {
      "id": "request",
      "kind": "builtin.identity",
      "inputs": {
        "input": {
          "exclusive": [
            {
              "$ref": "prefix_only.value"
            },
            {
              "$ref": "continue_request.messages"
            }
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "from_node": "params",
      "to_node": "route"
    },
    {
      "from_node": "route",
      "from_output": "prefix_only",
      "to_node": "prefix_only"
    },
    {
      "from_node": "route",
      "from_output": "else",
      "to_node": "continue_request"
    }
  ],
  "clusters": [
    {
      "label": "Compose messages",
      "annotation": "Forward the prefix unchanged when the generated suffix is empty.",
      "collapsed": true,
      "nodes": [
        "params",
        "route",
        "prefix_only",
        "continue_request",
        "request"
      ]
    }
  ],
  "outputs": [
    {
      "name": "messages",
      "node": "request",
      "port": "value"
    }
  ]
}
